@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card-wide">
        <h1 class="auth-title">Crear Cuenta</h1>
        <p class="auth-subtitle">Selecciona el tipo de cuenta que deseas crear</p>

        <div class="register-options">
            <a asp-page="/Account/Register" asp-route-tipo="espectador" class="register-option-card">
                <h3>Espectador</h3>
                <p>Ver resultados y seguir torneos</p>
            </a>

            <a asp-page="/Account/RegisterJugador" class="register-option-card">
                <h3>Jugador</h3>
                <p>Únete a equipos y participa en torneos</p>
            </a>

            <a asp-page="/Account/RegisterEntrenador" class="register-option-card">
                <h3>Entrenador</h3>
                <p>Crea tu equipo y gestiona jugadores</p>
            </a>

            <a asp-page="/Account/RegisterArbitro" class="register-option-card">
                <h3>Árbitro</h3>
                <p>Arbitra partidos y genera reportes</p>
            </a>
        </div>

        @if (Model.TipoSeleccionado == "espectador")
        {
            <div class="register-form-container">
                <h2>Registro de Espectador</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">@Model.ErrorMessage</div>
                }

                <form method="post" class="auth-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="InputEspectador.Nombre"></label>
                            <input asp-for="InputEspectador.Nombre" class="form-control" />
                            <span asp-validation-for="InputEspectador.Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="InputEspectador.ApellidoPaterno"></label>
                            <input asp-for="InputEspectador.ApellidoPaterno" class="form-control" />
                            <span asp-validation-for="InputEspectador.ApellidoPaterno" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="InputEspectador.ApellidoMaterno"></label>
                        <input asp-for="InputEspectador.ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="InputEspectador.ApellidoMaterno" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="InputEspectador.Email"></label>
                        <input asp-for="InputEspectador.Email" class="form-control" type="email" />
                        <span asp-validation-for="InputEspectador.Email" class="text-danger"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="InputEspectador.Password"></label>
                            <input asp-for="InputEspectador.Password" class="form-control" type="password" />
                            <span asp-validation-for="InputEspectador.Password" class="text-danger"></span>
                            <small class="form-text">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="InputEspectador.ConfirmPassword"></label>
                            <input asp-for="InputEspectador.ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="InputEspectador.ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Crear Cuenta</button>
                </form>
            </div>
        }

        <div class="auth-footer">
            <p>¿Ya tienes una cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}