@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión — Blazebol</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="auth-container">

    <!-- ── COLUMNA IZQUIERDA: FORMULARIO ── -->
    <div class="auth-form-col">

        <a href="/" class="auth-brand">
            <img src="~/images/logoblazebol.png" alt="Blazebol" />
            <span class="auth-brand-text">Blaze<span>bol</span></span>
        </a>

        <h1 class="auth-heading">Iniciar Sesión</h1>
        <p class="auth-sub">Accede a tu cuenta para gestionar torneos</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="auth-success">@Model.SuccessMessage</div>
        }

        <form method="post" class="auth-form" id="loginForm">
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                <input asp-for="Input.Email" class="form-control"
                       type="email" placeholder="correo@ejemplo.com" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Contraseña</label>
                <input asp-for="Input.Password" class="form-control"
                       type="password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="auth-check">
                <input asp-for="Input.RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">Recordarme</label>
            </div>

            <button type="submit" class="auth-btn" id="loginBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>
                </svg>
                Iniciar Sesión
            </button>

            <div class="auth-footer-link">
                ¿No tienes cuenta? <a asp-page="/Account/Register">Regístrate aquí</a>
            </div>
        </form>

    </div>

    <!-- ── COLUMNA DERECHA: IMAGEN + QUOTE ── -->
    <div class="auth-image-col">
        <div class="auth-quote-wrap">
            <h2 class="auth-quote">
                Gestiona tus torneos con <span class="hi">pasión</span>
            </h2>
            <p class="auth-quote-sub">
                Sistema profesional de control de torneos de fútbol para organizadores, equipos y árbitros
            </p>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    document.getElementById('loginForm').addEventListener('submit', function () {
        document.getElementById('loginBtn').disabled = true;
        document.getElementById('loginBtn').textContent = 'Iniciando...';
    });
</script>
</body>
</html>
