@page
@model RegisterArbitroModel
@{
    ViewData["Title"] = "Registro de Árbitro";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card-wide">
        <div class="auth-header">
            <a asp-page="/Account/Register" class="back-link">← Volver</a>
            <h1 class="auth-title">Registro de Árbitro</h1>
            <p class="auth-subtitle">Tu cuenta será revisada por un administrador antes de ser aprobada</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">
            <div class="form-section">
                <h3 class="form-section-title">Información Personal</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Nombre"></label>
                        <input asp-for="Input.Nombre" class="form-control" />
                        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ApellidoPaterno"></label>
                        <input asp-for="Input.ApellidoPaterno" class="form-control" />
                        <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.ApellidoMaterno"></label>
                        <input asp-for="Input.ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Telefono"></label>
                        <input asp-for="Input.Telefono" class="form-control" type="tel" placeholder="+503 1234-5678" />
                        <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Información de Árbitro</h3>
                
                <div class="form-group">
                    <label asp-for="Input.NumeroLicencia"></label>
                    <input asp-for="Input.NumeroLicencia" class="form-control" placeholder="Número de licencia oficial" />
                    <span asp-validation-for="Input.NumeroLicencia" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Nivel(es) de Licencia <span style="color:var(--accent)">*</span></label>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px;">
                        @foreach (var nivel in new[] { "Juvenil", "Amateur", "Municipal", "Regional", "Nacional", "Internacional" })
                        {
                            <label style="display:flex;align-items:center;gap:8px;font-weight:normal;cursor:pointer;padding:8px 12px;border:1px solid rgba(255,255,255,0.12);border-radius:6px;">
                                <input type="checkbox" name="nivelesLicencia" value="@nivel"
                                       style="width:16px;height:16px;accent-color:var(--accent);" />
                                <span>@nivel</span>
                            </label>
                        }
                    </div>
                    <small style="margin-top:6px;display:block;opacity:0.55;">
                        Selecciona todos los niveles de torneo en los que estás habilitado para arbitrar.
                        Esta información será verificada por el administrador.
                    </small>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Cuenta de Acceso</h3>
                
                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" type="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Password"></label>
                        <input asp-for="Input.Password" class="form-control" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <small class="form-text">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Nota:</strong> Tu cuenta quedará en estado "Pendiente de Aprobación" hasta que un administrador la revise y apruebe.
            </div>

            <button type="submit" class="btn btn-primary btn-block">Enviar Solicitud de Registro</button>
        </form>

        <div class="auth-footer">
            <p>¿Ya tienes una cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}