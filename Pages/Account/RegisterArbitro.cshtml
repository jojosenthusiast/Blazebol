@page
@model RegisterArbitroModel
@{
    ViewData["Title"] = "Registro de Árbitro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Árbitro — Blazebol</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="auth-container">

    <!-- ── COLUMNA IZQUIERDA: FORMULARIO ── -->
    <div class="auth-form-col">

        <a href="/" class="auth-brand">
            <img src="~/images/logoblazebol.png" alt="Blazebol" />
            <span class="auth-brand-text">Blaze<span>bol</span></span>
        </a>

        <a asp-page="/Account/Register" class="auth-back">← Cambiar tipo de cuenta</a>

        <h1 class="auth-heading">Registro de Árbitro</h1>
        <p class="auth-sub">Tu cuenta será revisada por un administrador antes de ser aprobada</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">

            <div class="auth-section-title">Información Personal</div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                    <input asp-for="Input.Nombre" class="form-control" placeholder="Juan" />
                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ApellidoPaterno" class="form-label">Apellido Paterno</label>
                    <input asp-for="Input.ApellidoPaterno" class="form-control" placeholder="Pérez" />
                    <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.ApellidoMaterno" class="form-label">Apellido Materno (opcional)</label>
                    <input asp-for="Input.ApellidoMaterno" class="form-control" placeholder="García" />
                    <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Input.Telefono" class="form-control" type="tel" placeholder="+503 1234-5678" />
                    <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-section-title">Información de Árbitro</div>

            <div class="form-group">
                <label asp-for="Input.NumeroLicencia" class="form-label">Número de Licencia *</label>
                <input asp-for="Input.NumeroLicencia" class="form-control" placeholder="Número de licencia oficial" />
                <span asp-validation-for="Input.NumeroLicencia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Nivel(es) de Licencia *</label>
                <div class="auth-checkgrid">
                    @foreach (var nivel in new[] { "Juvenil", "Amateur", "Municipal", "Regional", "Nacional", "Internacional" })
                    {
                        <label>
                            <input type="checkbox" name="nivelesLicencia" value="@nivel" />
                            <span>@nivel</span>
                        </label>
                    }
                </div>
                <small class="form-text" style="margin-top:8px;display:block;">
                    Selecciona todos los niveles en los que estás habilitado para arbitrar. Será verificado por el administrador.
                </small>
            </div>

            <div class="auth-info">
                <strong>Proceso de aprobación:</strong> Tu cuenta quedará en estado "Pendiente" hasta que un administrador revise y apruebe tu solicitud.
            </div>

            <div class="auth-section-title">Cuenta de Acceso</div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <small class="form-text" style="display:block;margin-bottom:20px;">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>

            <button type="submit" class="auth-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                Enviar Solicitud de Registro
            </button>

            <div class="auth-footer-link">
                ¿Ya tienes cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a>
            </div>

        </form>
    </div>

    <!-- ── COLUMNA DERECHA: IMAGEN + QUOTE ── -->
    <div class="auth-image-col">
        <div class="auth-quote-wrap">
            <h2 class="auth-quote">
                Garantiza la <span class="hi">justicia</span> del juego
            </h2>
            <p class="auth-quote-sub">
                Arbitra partidos profesionalmente, genera reportes detallados y mantén la integridad del deporte
            </p>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
