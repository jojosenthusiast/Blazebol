@page
@model RegisterJugadorModel
@{
    ViewData["Title"] = "Registro de Jugador";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card-wide">
        <div class="auth-header">
            <a asp-page="/Account/Register" class="back-link">← Volver</a>
            <h1 class="auth-title">Registro de Jugador</h1>
            <p class="auth-subtitle">Completa tu información para unirte a equipos</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">
            <div class="form-section">
                <h3 class="form-section-title">Información Personal</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Nombre"></label>
                        <input asp-for="Input.Nombre" class="form-control" />
                        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ApellidoPaterno"></label>
                        <input asp-for="Input.ApellidoPaterno" class="form-control" />
                        <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.ApellidoMaterno"></label>
                        <input asp-for="Input.ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.FechaNacimiento" class="required"></label>
                        <input asp-for="Input.FechaNacimiento" class="form-control" type="date" 
                            min="1950-01-01" 
                            max="@DateTime.Now.AddYears(-8).ToString("yyyy-MM-dd")" 
                            value="@DateTime.Now.AddYears(-20).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
                        <small class="form-text">Edad permitida: 8-75 años</small>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.NumeroIdentificacion"></label>
                        <input asp-for="Input.NumeroIdentificacion" class="form-control" placeholder="DUI o Pasaporte" />
                        <span asp-validation-for="Input.NumeroIdentificacion" class="text-danger"></span>
                        <small class="form-text">Este dato será cifrado para tu seguridad</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Telefono"></label>
                        <input asp-for="Input.Telefono" class="form-control" type="tel" placeholder="+503 1234-5678" />
                        <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Información de Jugador</h3>
                
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.PosicionPreferida"></label>
                        <select asp-for="Input.PosicionPreferida" class="form-control">
                            <option value="">Selecciona una posición</option>
                            <option value="Portero">Portero</option>
                            <option value="Defensa">Defensa</option>
                            <option value="Medio">Medio</option>
                            <option value="Delantero">Delantero</option>
                        </select>
                        <span asp-validation-for="Input.PosicionPreferida" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.NumeroCamiseta"></label>
                        <input asp-for="Input.NumeroCamiseta" class="form-control" type="number" min="1" max="99" placeholder="Ej: 10" />
                        <span asp-validation-for="Input.NumeroCamiseta" class="text-danger"></span>
                        <small class="form-text">Número preferido (1-99)</small>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Cuenta de Acceso</h3>
                
                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" type="email" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Input.Password"></label>
                        <input asp-for="Input.Password" class="form-control" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <small class="form-text">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Crear Cuenta de Jugador</button>
        </form>

        <div class="auth-footer">
            <p>¿Ya tienes una cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}