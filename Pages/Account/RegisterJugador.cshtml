@page
@model RegisterJugadorModel
@{
    ViewData["Title"] = "Registro de Jugador";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Jugador — Blazebol</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="auth-container">

    <!-- ── COLUMNA IZQUIERDA: FORMULARIO ── -->
    <div class="auth-form-col">

        <a href="/" class="auth-brand">
            <img src="~/images/logoblazebol.png" alt="Blazebol" />
            <span class="auth-brand-text">Blaze<span>bol</span></span>
        </a>

        <a asp-page="/Account/Register" class="auth-back">← Cambiar tipo de cuenta</a>

        <h1 class="auth-heading">Registro de Jugador</h1>
        <p class="auth-sub">Completa tu información para unirte a equipos y torneos</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">

            <div class="auth-section-title">Información Personal</div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                    <input asp-for="Input.Nombre" class="form-control" placeholder="Juan" />
                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ApellidoPaterno" class="form-label">Apellido Paterno</label>
                    <input asp-for="Input.ApellidoPaterno" class="form-control" placeholder="Pérez" />
                    <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.ApellidoMaterno" class="form-label">Apellido Materno (opcional)</label>
                    <input asp-for="Input.ApellidoMaterno" class="form-control" placeholder="García" />
                    <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.FechaNacimiento" class="form-label">Fecha de Nacimiento *</label>
                    <input asp-for="Input.FechaNacimiento" class="form-control" type="date"
                           min="1950-01-01"
                           max="@DateTime.Now.AddYears(-8).ToString("yyyy-MM-dd")"
                           value="@DateTime.Now.AddYears(-20).ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span>
                    <small class="form-text">Edad permitida: 8–75 años</small>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.NumeroIdentificacion" class="form-label">DUI / Pasaporte</label>
                    <input asp-for="Input.NumeroIdentificacion" class="form-control" placeholder="00000000-0" />
                    <span asp-validation-for="Input.NumeroIdentificacion" class="text-danger"></span>
                    <small class="form-text">Cifrado para tu seguridad</small>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Input.Telefono" class="form-control" type="tel" placeholder="+503 1234-5678" />
                    <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-section-title">Información de Jugador</div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.PosicionPreferida" class="form-label">Posición</label>
                    <select asp-for="Input.PosicionPreferida" class="form-control">
                        <option value="">Selecciona una posición</option>
                        <option value="Portero">Portero</option>
                        <option value="Defensa">Defensa</option>
                        <option value="Medio">Medio</option>
                        <option value="Delantero">Delantero</option>
                    </select>
                    <span asp-validation-for="Input.PosicionPreferida" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.NumeroCamiseta" class="form-label">Número de Camiseta</label>
                    <input asp-for="Input.NumeroCamiseta" class="form-control" type="number" min="1" max="99" placeholder="10" />
                    <span asp-validation-for="Input.NumeroCamiseta" class="text-danger"></span>
                    <small class="form-text">Número preferido (1–99)</small>
                </div>
            </div>

            <div class="auth-section-title">Cuenta de Acceso</div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <small class="form-text" style="display:block;margin-bottom:20px;">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>

            <button type="submit" class="auth-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                Crear Cuenta de Jugador
            </button>

            <div class="auth-footer-link">
                ¿Ya tienes cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a>
            </div>

        </form>
    </div>

    <!-- ── COLUMNA DERECHA: IMAGEN + QUOTE ── -->
    <div class="auth-image-col">
        <div class="auth-quote-wrap">
            <h2 class="auth-quote">
                Demuestra tu <span class="hi">talento</span> en la cancha
            </h2>
            <p class="auth-quote-sub">
                Únete a equipos, compite en torneos y construye tu carrera deportiva con Blazebol
            </p>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
