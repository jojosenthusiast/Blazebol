@page
@model RegisterEntrenadorModel
@{
    ViewData["Title"] = "Registro de Entrenador";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Entrenador — Blazebol</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<div class="auth-container">

    <!-- ── COLUMNA IZQUIERDA: FORMULARIO ── -->
    <div class="auth-form-col">

        <a href="/" class="auth-brand">
            <img src="~/images/logoblazebol.png" alt="Blazebol" />
            <span class="auth-brand-text">Blaze<span>bol</span></span>
        </a>

        <a asp-page="/Account/Register" class="auth-back">← Cambiar tipo de cuenta</a>

        <h1 class="auth-heading">Registro de Entrenador</h1>
        <p class="auth-sub">Crea tu cuenta y tu equipo en un solo paso</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form" enctype="multipart/form-data">

            <div class="auth-section-title">Información Personal</div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                    <input asp-for="Input.Nombre" class="form-control" placeholder="Juan" />
                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ApellidoPaterno" class="form-label">Apellido Paterno</label>
                    <input asp-for="Input.ApellidoPaterno" class="form-control" placeholder="Pérez" />
                    <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.ApellidoMaterno" class="form-label">Apellido Materno (opcional)</label>
                    <input asp-for="Input.ApellidoMaterno" class="form-control" placeholder="García" />
                    <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Input.Telefono" class="form-control" type="tel" placeholder="+503 1234-5678" />
                    <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.NumeroLicencia" class="form-label">N.º Licencia (opcional)</label>
                    <input asp-for="Input.NumeroLicencia" class="form-control" placeholder="Opcional" />
                    <span asp-validation-for="Input.NumeroLicencia" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.FechaExpiracionLicencia" class="form-label">Expiración Licencia</label>
                    <input asp-for="Input.FechaExpiracionLicencia" class="form-control" type="date" />
                    <span asp-validation-for="Input.FechaExpiracionLicencia" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-section-title">Información del Equipo</div>
            <p style="font-size:12px;color:#555;margin-bottom:14px;">Tu equipo se creará automáticamente al registrarte</p>

            <div class="form-group">
                <label asp-for="Input.NombreEquipo" class="form-label">Nombre del Equipo *</label>
                <input asp-for="Input.NombreEquipo" class="form-control" placeholder="Ej: Deportivo San Salvador" />
                <span asp-validation-for="Input.NombreEquipo" class="text-danger"></span>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.ColorPrimario" class="form-label">Color Primario</label>
                    <div class="auth-color-pair">
                        <input asp-for="Input.ColorPrimario" type="color" value="#FF0000" id="colorPrimarioPicker" />
                        <input asp-for="Input.ColorPrimario" class="form-control" type="text" placeholder="#FF0000" id="colorPrimarioText" />
                    </div>
                    <span asp-validation-for="Input.ColorPrimario" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ColorSecundario" class="form-label">Color Secundario</label>
                    <div class="auth-color-pair">
                        <input asp-for="Input.ColorSecundario" type="color" value="#FFFFFF" id="colorSecundarioPicker" />
                        <input asp-for="Input.ColorSecundario" class="form-control" type="text" placeholder="#FFFFFF" id="colorSecundarioText" />
                    </div>
                    <span asp-validation-for="Input.ColorSecundario" class="text-danger"></span>
                </div>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Abreviacion" class="form-label">Abreviación (3 letras)</label>
                    <input asp-for="Input.Abreviacion" class="form-control" placeholder="DSS" maxlength="3"
                           style="text-transform:uppercase;" />
                    <span asp-validation-for="Input.Abreviacion" class="text-danger"></span>
                    <small class="form-text">Siglas del equipo (ej: DSS)</small>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Sede" class="form-label">Sede Principal</label>
                    <input asp-for="Input.Sede" class="form-control" placeholder="Estadio Cuscatlán" />
                    <span asp-validation-for="Input.Sede" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Escudo del Equipo (opcional)</label>
                <input type="file" id="LogoFile" name="LogoFile" class="form-control"
                       accept="image/png,image/jpeg,image/jpg,image/svg+xml,image/webp" />
                <small class="form-text">PNG, JPG, SVG o WebP · Máx. 2 MB</small>
                <div id="logoPreview" style="margin-top:10px;display:none;">
                    <img id="logoPreviewImg" style="max-width:100px;max-height:100px;border-radius:8px;border:1px solid #2a2a2a;" />
                </div>
            </div>

            <div class="auth-section-title">Cuenta de Acceso</div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Correo Electrónico</label>
                <input asp-for="Input.Email" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-row">
                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <small class="form-text" style="display:block;margin-bottom:20px;">Mínimo 8 caracteres, 1 mayúscula, 1 minúscula y 1 número</small>

            <button type="submit" class="auth-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                Crear Cuenta y Equipo
            </button>

            <div class="auth-footer-link">
                ¿Ya tienes cuenta? <a asp-page="/Account/Login">Inicia sesión aquí</a>
            </div>

        </form>
    </div>

    <!-- ── COLUMNA DERECHA: IMAGEN + QUOTE ── -->
    <div class="auth-image-col">
        <div class="auth-quote-wrap">
            <h2 class="auth-quote">
                Lidera con <span class="hi">estrategia</span> y pasión
            </h2>
            <p class="auth-quote-sub">
                Gestiona tu equipo, planifica tus alineaciones y lleva a tus jugadores a la victoria
            </p>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Logo preview
    document.getElementById('LogoFile').addEventListener('change', function (e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
            document.getElementById('logoPreviewImg').src = ev.target.result;
            document.getElementById('logoPreview').style.display = 'block';
        };
        reader.readAsDataURL(file);
    });

    // Color sync
    function syncColor(picker, text) {
        picker.addEventListener('change', () => { text.value = picker.value; });
        text.addEventListener('input', () => {
            if (/^#[0-9A-F]{6}$/i.test(text.value)) picker.value = text.value;
        });
    }
    syncColor(document.getElementById('colorPrimarioPicker'), document.getElementById('colorPrimarioText'));
    syncColor(document.getElementById('colorSecundarioPicker'), document.getElementById('colorSecundarioText'));
</script>
</body>
</html>
