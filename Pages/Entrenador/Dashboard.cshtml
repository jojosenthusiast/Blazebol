@page
@model DashboardModel
@{
    ViewData["Title"] = "Mi Dashboard - Entrenador";
    Layout = "_Layout";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Mi Dashboard de Entrenador</h1>
        <p class="dashboard-subtitle">Bienvenido, @Model.NombreCompleto</p>
    </div>

    <div class="coach-info-card">
        <div style="display:flex;align-items:center;gap:20px;">
            <i class="bi bi-person-badge-fill" style="font-size:3rem;color:var(--color-accent);flex-shrink:0;"></i>
            <div>
                <h2>@Model.NombreCompleto</h2>
                @if (!string.IsNullOrEmpty(Model.NombreEquipo))
                {
                    <p class="team-name">
                        <i class="bi bi-shield-fill text-accent"></i>
                        <strong> @Model.NombreEquipo</strong>
                    </p>
                }
                else
                {
                    <p class="no-team text-muted">Sin equipo asignado</p>
                }
                <span class="badge badge-entrenador" style="margin-top:6px;">Entrenador</span>
            </div>
        </div>
    </div>

    <div class="recent-section">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <h2 style="margin:0;">Próximos Partidos</h2>
            <a asp-page="/Calendario/Index" class="btn btn-sm btn-info btn-icon">
                <i class="bi bi-calendar3"></i> Ver Calendario
            </a>
        </div>
        @if (Model.ProximosPartidos.Any())
        {
            <div class="match-mini-list">
                @foreach (var p in Model.ProximosPartidos)
                {
                    <div class="match-mini-card">
                        <div class="match-mini-dot" style="background:@p.ColorTorneo;"></div>
                        <div class="match-mini-body">
                            <div class="match-mini-teams"><strong>@p.AbrevLocal</strong> vs <strong>@p.AbrevVisitante</strong></div>
                            <div class="match-mini-meta">@p.Fecha.ToString("dd/MM HH:mm") · @p.NombreTorneo@(p.Sede != null ? " · " + p.Sede : "")</div>
                        </div>
                        <a asp-page="/Entrenador/Partidos/Index" class="btn btn-sm btn-info btn-icon" style="flex-shrink:0;">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:16px;">
                <i class="bi bi-calendar-x empty-icon"></i>
                <p>No hay partidos próximos programados para tu equipo</p>
            </div>
        }
    </div>

    <div class="dashboard-actions">
        <h2>Acciones Rápidas</h2>
        <div class="action-cards">
            <a asp-page="/Entrenador/Plantilla/Index" class="action-card">
                <i class="bi bi-people-fill action-icon" style="color:var(--color-accent);"></i>
                <h3>Gestionar Plantilla</h3>
                <p>Agregar, editar o dar de baja jugadores</p>
            </a>

            <a asp-page="/Entrenador/Solicitudes/Index" class="action-card">
                <i class="bi bi-envelope-check action-icon" style="color:var(--color-info);"></i>
                <h3>Solicitudes</h3>
                <p>Revisar solicitudes e invitaciones enviadas</p>
            </a>

            <a asp-page="/Entrenador/Partidos/Index" class="action-card">
                <i class="bi bi-calendar-event action-icon" style="color:var(--color-warning);"></i>
                <h3>Partidos</h3>
                <p>Calendario, resultados y convocatoria</p>
            </a>

            <div class="action-card action-card-disabled">
                <i class="bi bi-bar-chart-fill action-icon"></i>
                <h3>Estadísticas</h3>
                <p>Próximamente disponible</p>
            </div>
        </div>
    </div>
</div>
