@page "{id:int}"
@model ControlTorneosFutbol.Pages.Entrenador.Partidos.ConvocatoriaModel
@{
    ViewData["Title"] = "Convocatoria";
    Layout = "_Layout";
    var p = Model.Partido;
    string estadoColor = p.Estado switch {
        "Finalizado" => "var(--accent)",
        "EnCurso"    => "#f59e0b",
        "Cancelado"  => "#ef4444",
        _            => "rgba(255,255,255,0.5)"
    };
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Entrenador/Partidos/Index" class="back-link">← Volver a Mis Partidos</a>
            <h1>Convocatoria del Partido</h1>
            <span class="badge" style="background:rgba(255,255,255,0.08);color:@estadoColor;font-size:0.85rem;">@p.Estado</span>
        </div>
    </div>

    <!-- ENCABEZADO DEL PARTIDO -->
    <div class="card" style="margin-bottom:24px;background:linear-gradient(135deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));">
        <div class="card-body" style="padding:28px 32px;">
            <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center;text-align:center;">
                <!-- Local -->
                <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                    @{
                        string bgLocal = string.IsNullOrEmpty(p.ColorLocal) ? "rgba(255,255,255,0.08)" : p.ColorLocal + "22";
                    }
                    <div style="width:60px;height:60px;border-radius:10px;background:@bgLocal;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(p.LogoLocal))
                        {
                            <img src="@p.LogoLocal" style="width:54px;height:54px;object-fit:contain;" />
                        }
                        else if (!string.IsNullOrEmpty(p.AbrevLocal))
                        {
                            <span style="font-weight:800;font-size:0.9rem;color:@(p.ColorLocal ?? "rgba(255,255,255,0.6)");">@p.AbrevLocal</span>
                        }
                        else { <span style="font-size:1.8rem;opacity:0.2;">⚽</span> }
                    </div>
                    <div style="font-size:1.3rem;font-weight:800;">@p.NombreLocal</div>
                    <div style="font-size:0.78rem;opacity:0.5;">Local</div>
                </div>

                <!-- Resultado / Vs -->
                <div style="text-align:center;">
                    @if (p.Estado == "Finalizado" && p.GolesLocal.HasValue)
                    {
                        <div style="font-size:3rem;font-weight:900;letter-spacing:-3px;color:var(--accent);">
                            @p.GolesLocal <span style="opacity:0.4;font-size:2rem;">–</span> @p.GolesVisitante
                        </div>
                    }
                    else
                    {
                        <div style="font-size:1.8rem;font-weight:700;opacity:0.35;">vs</div>
                        <div style="font-size:0.8rem;opacity:0.5;margin-top:4px;">@p.Fecha.ToString("dd/MM/yyyy · HH:mm")</div>
                    }
                </div>

                <!-- Visitante -->
                <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                    @{
                        string bgVisit = string.IsNullOrEmpty(p.ColorVisitante) ? "rgba(255,255,255,0.08)" : p.ColorVisitante + "22";
                    }
                    <div style="width:60px;height:60px;border-radius:10px;background:@bgVisit;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(p.LogoVisitante))
                        {
                            <img src="@p.LogoVisitante" style="width:54px;height:54px;object-fit:contain;" />
                        }
                        else if (!string.IsNullOrEmpty(p.AbrevVisitante))
                        {
                            <span style="font-weight:800;font-size:0.9rem;color:@(p.ColorVisitante ?? "rgba(255,255,255,0.6)");">@p.AbrevVisitante</span>
                        }
                        else { <span style="font-size:1.8rem;opacity:0.2;">⚽</span> }
                    </div>
                    <div style="font-size:1.3rem;font-weight:800;">@p.NombreVisitante</div>
                    <div style="font-size:0.78rem;opacity:0.5;">Visitante</div>
                </div>
            </div>
        </div>
    </div>

    <!-- INFO -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
        <div class="card">
            <div class="card-header"><h3 style="margin:0;">Información del Partido</h3></div>
            <div class="card-body">
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <div>
                        <span style="font-size:0.7rem;opacity:0.45;display:block;">TORNEO</span>
                        <span>@p.NombreTorneo
                        @if (!string.IsNullOrEmpty(p.NombreGrupo))
                        {
                            <span class="badge" style="background:rgba(255,255,255,0.08);font-size:0.7rem;margin-left:6px;">@p.NombreGrupo</span>
                        }
                        </span>
                    </div>
                    <div>
                        <span style="font-size:0.7rem;opacity:0.45;display:block;">FECHA Y HORA</span>
                        <span>@p.Fecha.ToString("dddd dd 'de' MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("es-ES"))</span>
                    </div>
                    <div>
                        <span style="font-size:0.7rem;opacity:0.45;display:block;">SEDE</span>
                        <span>@(p.Sede ?? "Sin sede asignada")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 style="margin:0;">Árbitro</h3></div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(p.NombreArbitro))
                {
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:44px;height:44px;border-radius:50%;background:rgba(163,255,18,0.12);display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;color:var(--accent);">
                            @p.NombreArbitro[0]
                        </div>
                        <div>
                            <strong>@p.NombreArbitro</strong>
                            <div style="font-size:0.78rem;opacity:0.5;">Árbitro Principal</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="opacity:0.5;font-style:italic;">Sin árbitro asignado</div>
                }
            </div>
        </div>
    </div>

    <!-- PLANTILLAS -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
        <div class="card">
            <div class="card-header">
                <h3 style="margin:0;">@p.NombreLocal</h3>
                <span style="font-size:0.78rem;opacity:0.5;">@Model.JugadoresLocal.Count jugadores</span>
            </div>
            <div class="card-body" style="padding:0;">
                @if (Model.JugadoresLocal.Any())
                {
                    <table class="data-table" style="font-size:0.88rem;">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Jugador</th>
                                <th>Posición</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in Model.JugadoresLocal)
                            {
                                <tr>
                                    <td style="font-weight:700;opacity:0.6;">@j.NumeroCamiseta</td>
                                    <td>@j.NombreCompleto</td>
                                    <td style="opacity:0.6;font-size:0.8rem;">@j.Posicion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="padding:16px;opacity:0.5;font-size:0.85rem;">Sin jugadores inscritos.</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 style="margin:0;">@p.NombreVisitante</h3>
                <span style="font-size:0.78rem;opacity:0.5;">@Model.JugadoresVisitante.Count jugadores</span>
            </div>
            <div class="card-body" style="padding:0;">
                @if (Model.JugadoresVisitante.Any())
                {
                    <table class="data-table" style="font-size:0.88rem;">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Jugador</th>
                                <th>Posición</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in Model.JugadoresVisitante)
                            {
                                <tr>
                                    <td style="font-weight:700;opacity:0.6;">@j.NumeroCamiseta</td>
                                    <td>@j.NombreCompleto</td>
                                    <td style="opacity:0.6;font-size:0.8rem;">@j.Posicion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="padding:16px;opacity:0.5;font-size:0.85rem;">Sin jugadores inscritos.</div>
                }
            </div>
        </div>
    </div>

    <!-- CLASIFICACIÓN -->
    @if (Model.Clasificacion.Any())
    {
        <div class="card">
            <div class="card-header">
                <h3 style="margin:0;">Clasificación — @p.NombreTorneo</h3>
            </div>
            <div class="card-body" style="padding:0;overflow-x:auto;">
                <table class="data-table" style="min-width:560px;">
                    <thead>
                        <tr>
                            <th style="width:40px;">Pos</th>
                            <th>Equipo</th>
                            <th title="Partidos Jugados" style="width:40px;">PJ</th>
                            <th style="width:40px;">G</th>
                            <th style="width:40px;">E</th>
                            <th style="width:40px;">P</th>
                            <th style="width:40px;">GF</th>
                            <th style="width:40px;">GC</th>
                            <th style="width:40px;">DG</th>
                            <th style="width:50px;color:var(--accent);">Pts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Clasificacion)
                        {
                            bool esLocal = c.EquipoId == Model.Partido.TorneoId; // placeholder check
                            string rowBg = (c.NombreEquipo == Model.Partido.NombreLocal || c.NombreEquipo == Model.Partido.NombreVisitante)
                                ? "background:rgba(163,255,18,0.05);" : "";
                            <tr style="@rowBg">
                                <td style="font-weight:700;">
                                    @if (c.Posicion == 1) { <span style="color:var(--accent);">@c.Posicion</span> }
                                    else if (c.Posicion == 2) { <span style="color:#c0c0c0;">@c.Posicion</span> }
                                    else if (c.Posicion == 3) { <span style="color:#cd7f32;">@c.Posicion</span> }
                                    else { <span>@c.Posicion</span> }
                                </td>
                                <td>
                                    <strong>@c.NombreEquipo</strong>
                                    @if (!string.IsNullOrEmpty(c.Abreviacion))
                                    {
                                        <span style="font-size:0.72rem;opacity:0.35;margin-left:6px;">[@c.Abreviacion]</span>
                                    }
                                </td>
                                <td style="text-align:center;opacity:0.8;">@c.PJ</td>
                                <td style="text-align:center;">@c.PG</td>
                                <td style="text-align:center;opacity:0.7;">@c.PE</td>
                                <td style="text-align:center;opacity:0.7;">@c.PP</td>
                                <td style="text-align:center;">@c.GF</td>
                                <td style="text-align:center;opacity:0.7;">@c.GC</td>
                                <td style="text-align:center;color:@(c.DG > 0 ? "var(--accent)" : c.DG < 0 ? "#ef4444" : "inherit");">
                                    @(c.DG > 0 ? "+" : "")@c.DG
                                </td>
                                <td style="text-align:center;font-weight:800;color:var(--accent);">@c.Pts</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
