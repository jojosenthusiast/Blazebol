@page
@model ControlTorneosFutbol.Pages.Entrenador.Plantilla.AgregarModel
@{
    ViewData["Title"] = "Agregar Jugador";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Entrenador/Plantilla/Index" class="back-link">← Volver a Plantilla</a>
            <h1>Agregar Jugador</h1>
            <p class="page-subtitle">@Model.NombreEquipo</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    @if (!Model.TorneosDisponibles.Any())
    {
        <div class="alert alert-error">
            Tu equipo no está inscrito en ningún torneo activo. Contacta al administrador para ser inscrito.
        </div>
    }
    else
    {
        <div class="form-container" style="max-width:600px;margin-bottom:24px;">
            <form method="get" class="form-horizontal">
                <div class="form-section">
                    <h3 class="form-section-title">Buscar Jugador</h3>

                    <div class="form-group">
                        <label>Torneo <span style="color:var(--accent)">*</span></label>
                        <select name="torneoId" class="form-control" required>
                            <option value="">-- Seleccionar torneo --</option>
                            @foreach (var t in Model.TorneosDisponibles)
                            {
                                <option value="@t.TorneoId" selected="@(Model.TorneoSeleccionado == t.TorneoId)">@t.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Buscar por nombre o correo</label>
                        <input type="text" name="buscar" class="form-control"
                               value="@Model.BuscarTerm"
                               placeholder="Ej: Juan García o juan@email.com" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Buscar</button>
                    @if (Model.TorneoSeleccionado.HasValue)
                    {
                        <a asp-page="/Entrenador/Plantilla/Index" asp-route-torneoId="@Model.TorneoSeleccionado"
                           class="btn btn-secondary">Cancelar</a>
                    }
                </div>
            </form>
        </div>

        @if (Model.TorneoSeleccionado.HasValue)
        {
            @if (!Model.Resultados.Any())
            {
                <div class="empty-state">
                    @if (!string.IsNullOrEmpty(Model.BuscarTerm))
                    {
                        <p>No se encontraron jugadores con "<strong>@Model.BuscarTerm</strong>"</p>
                    }
                    else
                    {
                        <p>No hay jugadores registrados aún.</p>
                    }
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header">
                        <h3 style="margin:0;">Resultados — @Model.Resultados.Count encontrado(s)</h3>
                    </div>
                    <div class="card-body" style="padding:0;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Jugador</th>
                                    <th>Correo</th>
                                    <th>Posición</th>
                                    <th>Disponibilidad</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in Model.Resultados)
                                {
                                    <tr>
                                        <td><strong>@j.NombreCompleto</strong></td>
                                        <td style="font-size:0.85rem;opacity:0.8;">@j.Email</td>
                                        <td>@(j.PosicionPreferida ?? "—")</td>
                                        <td>
                                            @if (j.YaEnEsteEquipo)
                                            {
                                                <span class="badge badge-activo">Ya en tu equipo</span>
                                            }
                                            else if (j.InvitacionPendiente)
                                            {
                                                <span class="badge" style="background:rgba(163,255,18,0.15);color:var(--accent);">Invitación enviada</span>
                                            }
                                            else if (j.YaEnOtroEquipo)
                                            {
                                                <span class="badge" style="background:rgba(255,165,0,0.15);color:orange;">En otro equipo</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background:rgba(255,255,255,0.1);">Libre</span>
                                            }
                                        </td>
                                        <td>
                                            @if (j.PuedeAgregarDirecto)
                                            {
                                                <form method="post" asp-page-handler="Agregar"
                                                      style="display:flex;gap:6px;align-items:center;">
                                                    <input type="hidden" name="jugadorId" value="@j.JugadorId" />
                                                    <input type="hidden" name="torneoId" value="@Model.TorneoSeleccionado" />
                                                    <input type="number" name="numeroCamiseta"
                                                           placeholder="Nº" min="1" max="99"
                                                           class="form-control" style="width:72px;" required
                                                           title="Número de camiseta (1-99)" />
                                                    <button type="submit" class="btn btn-primary btn-sm">Agregar</button>
                                                </form>
                                            }
                                            else if (j.PuedeInvitar)
                                            {
                                                <form method="post" asp-page-handler="Invitar"
                                                      style="display:inline;">
                                                    <input type="hidden" name="jugadorId" value="@j.JugadorId" />
                                                    <input type="hidden" name="torneoId" value="@Model.TorneoSeleccionado" />
                                                    <button type="submit" class="btn btn-secondary btn-sm"
                                                            title="El jugador está en otro equipo. Se enviará una invitación que deberá aceptar.">
                                                        Enviar Invitación
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span style="opacity:0.4;font-size:0.8rem;">Sin acción</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
</div>
