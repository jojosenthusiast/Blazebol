@page "{id:int}"
@model ControlTorneosFutbol.Pages.Espectador.TorneoDetalleModel
@using ControlTorneosFutbol.Data.Entities
@using ControlTorneosFutbol.Pages.Espectador
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.Torneo?.Nombre ?? "Detalle de Torneo";
    Layout = "_Layout";
}

<div class="page-container">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
        <a asp-page="/Espectador/Torneos" class="btn btn-secondary">← Volver a Torneos</a>
    }
    else
    {
        <!-- HEADER -->
        <div class="page-header">
            <div>
                <a asp-page="/Espectador/Torneos" class="back-link">← Todos los torneos</a>
                <h1>@Model.Torneo.Nombre</h1>
                <p class="page-subtitle">
                    @Model.Torneo.Liga.Nombre &nbsp;·&nbsp;
                    @Model.Torneo.Temporada.Nombre &nbsp;·&nbsp;
                    @Model.Torneo.Categoria.Nombre
                </p>
            </div>
            <span class="badge badge-@Model.Torneo.Estado.ToLower()"
                  style="font-size:0.9rem;padding:6px 16px;align-self:flex-start;">
                @Model.Torneo.Estado
            </span>
        </div>

        <!-- INFO RÁPIDA -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:28px;">
            <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:14px;">
                <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:4px;">FORMATO</div>
                <strong style="font-size:0.85rem;">
                    @(Model.Torneo.Formato switch {
                        FormatosTorneo.TodosContraTodos => "Liga — Todos vs Todos",
                        FormatosTorneo.EliminacionDirecta => "Eliminación Directa",
                        FormatosTorneo.GruposYEliminacion => "Grupos + Eliminación",
                        _ => Model.Torneo.Formato })
                </strong>
            </div>
            <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:14px;">
                <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:4px;">PERÍODO</div>
                <strong style="font-size:0.85rem;">
                    @Model.Torneo.FechaInicio.ToString("dd/MM/yy") — @Model.Torneo.FechaFin.ToString("dd/MM/yyyy")
                </strong>
            </div>
            <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:14px;">
                <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:4px;">EQUIPOS</div>
                <strong style="font-size:0.85rem;">@Model.Torneo.EquiposTorneos.Count inscritos</strong>
            </div>
            @if (Model.Config != null)
            {
                <div style="background:rgba(255,255,255,0.04);border-radius:10px;padding:14px;">
                    <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:4px;">PTS V / E / D</div>
                    <strong style="font-size:0.85rem;">
                        @Model.Config.PuntosPorVictoria / @Model.Config.PuntosPorEmpate / @Model.Config.PuntosPorDerrota
                    </strong>
                </div>
            }
        </div>

        @* ============================================================
           MODO FINALIZADO — Solo campeón + tabla de honor
           ============================================================ *@
        @if (Model.EsFinalizado)
        {
            <!-- Tarjeta Campeón -->
            @if (Model.Campeon != null)
            {
                var c = Model.Campeon;
                string accentC = c.ColorPrimario ?? "var(--accent)";
                string bgC = c.ColorPrimario != null ? c.ColorPrimario + "20" : "rgba(163,255,18,0.08)";
                string borderC = c.ColorPrimario ?? "rgba(163,255,18,0.4)";

                <div style="border:2px solid @borderC;border-radius:16px;background:@bgC;padding:32px;text-align:center;margin-bottom:28px;">
                    <div style="font-size:0.72rem;opacity:0.5;letter-spacing:0.12em;margin-bottom:14px;"><i class="bi bi-trophy-fill"></i> CAMPEÓN DEL TORNEO</div>

                    <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
                        @{
                            string logoBgC = c.ColorPrimario != null ? c.ColorPrimario + "30" : "rgba(255,255,255,0.1)";
                        }
                        <div style="width:80px;height:80px;border-radius:14px;background:@logoBgC;display:flex;align-items:center;justify-content:center;overflow:hidden;">
                            @if (!string.IsNullOrEmpty(c.Logo))
                            {
                                <img src="@c.Logo" style="width:70px;height:70px;object-fit:contain;" />
                            }
                            else if (!string.IsNullOrEmpty(c.Abreviacion))
                            {
                                <span style="font-weight:900;font-size:1.3rem;color:@accentC;">@c.Abreviacion</span>
                            }
                            else
                            {
                                <i class="bi bi-dribbble" style="font-size:2rem;opacity:0.3;"></i>
                            }
                        </div>
                        <div style="font-size:2rem;font-weight:900;color:@accentC;">@c.NombreEquipo</div>
                        @if (!string.IsNullOrEmpty(c.Abreviacion))
                        {
                            <div style="font-size:0.85rem;opacity:0.45;">[@c.Abreviacion]</div>
                        }
                        @if (c.PJ > 0)
                        {
                            <div style="display:flex;gap:20px;margin-top:8px;">
                                <div style="text-align:center;">
                                    <div style="font-size:0.65rem;opacity:0.4;letter-spacing:0.07em;">PJ</div>
                                    <div style="font-weight:700;">@c.PJ</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:0.65rem;opacity:0.4;letter-spacing:0.07em;">PG</div>
                                    <div style="font-weight:700;color:@accentC;">@c.PG</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:0.65rem;opacity:0.4;letter-spacing:0.07em;">PE</div>
                                    <div style="font-weight:700;">@c.PE</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:0.65rem;opacity:0.4;letter-spacing:0.07em;">PP</div>
                                    <div style="font-weight:700;opacity:0.6;">@c.PP</div>
                                </div>
                                <div style="text-align:center;">
                                    <div style="font-size:0.65rem;opacity:0.4;letter-spacing:0.07em;">PTS</div>
                                    <div style="font-weight:900;font-size:1.1rem;color:@accentC;">@c.Pts</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Tabla de Honor / Posiciones finales -->
            @if (Model.TablaFinal.Count > 1)
            {
                <div class="card" style="margin-bottom:24px;">
                    <div class="card-header">
                        <h3 style="margin:0;">Tabla de Honor — Posiciones Finales</h3>
                    </div>
                    <div class="card-body" style="padding:0;overflow-x:auto;">
                        <table class="data-table" style="min-width:460px;">
                            <thead>
                                <tr>
                                    <th style="width:36px;text-align:center;">#</th>
                                    <th>Equipo</th>
                                    @if (Model.TablaFinal.Any(t => t.PJ > 0))
                                    {
                                        <th title="Partidos Jugados" style="text-align:center;width:40px;">PJ</th>
                                        <th title="Victorias" style="text-align:center;width:40px;">PG</th>
                                        <th title="Empates" style="text-align:center;width:40px;">PE</th>
                                        <th title="Derrotas" style="text-align:center;width:40px;">PP</th>
                                        <th title="Goles Favor" style="text-align:center;width:40px;">GF</th>
                                        <th title="Goles Contra" style="text-align:center;width:40px;">GC</th>
                                        <th title="Diferencia" style="text-align:center;width:40px;">DG</th>
                                        <th title="Puntos" style="text-align:center;width:50px;color:var(--accent);">Pts</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.TablaFinal)
                                {
                                    string posStyle = row.Posicion == 1 ? "color:#FFD700;font-weight:700;" :
                                                      row.Posicion == 2 ? "color:#C0C0C0;font-weight:700;" :
                                                      row.Posicion == 3 ? "color:#CD7F32;font-weight:700;" : "opacity:0.6;";
                                    string escudoHtml = !string.IsNullOrEmpty(row.Logo)
                                        ? $"<img src='{System.Net.WebUtility.HtmlEncode(row.Logo)}' style='width:22px;height:22px;object-fit:contain;border-radius:3px;flex-shrink:0;'/>"
                                        : !string.IsNullOrEmpty(row.ColorPrimario)
                                            ? $"<span style='display:inline-block;width:12px;height:12px;border-radius:2px;background:{row.ColorPrimario};flex-shrink:0;'></span>"
                                            : "";
                                    <tr>
                                        <td style="text-align:center;@posStyle">@row.Posicion</td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:8px;">
                                                @Html.Raw(escudoHtml)
                                                <strong>@row.NombreEquipo</strong>
                                                @if (!string.IsNullOrEmpty(row.Abreviacion))
                                                {
                                                    <span style="font-size:0.72rem;opacity:0.35;">[@row.Abreviacion]</span>
                                                }
                                            </div>
                                        </td>
                                        @if (Model.TablaFinal.Any(t => t.PJ > 0))
                                        {
                                            string dgStyle = row.DG > 0 ? "color:#a3ff12;" : row.DG < 0 ? "color:#ef4444;" : "";
                                            <td style="text-align:center;">@row.PJ</td>
                                            <td style="text-align:center;">@row.PG</td>
                                            <td style="text-align:center;opacity:0.65;">@row.PE</td>
                                            <td style="text-align:center;opacity:0.65;">@row.PP</td>
                                            <td style="text-align:center;">@row.GF</td>
                                            <td style="text-align:center;opacity:0.65;">@row.GC</td>
                                            <td style="text-align:center;@dgStyle">@(row.DG > 0 ? "+" : "")@row.DG</td>
                                            <td style="text-align:center;font-weight:800;color:var(--accent);">@row.Pts</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            @* ============================================================
               MODO ACTIVO — Clasificación + Partidos
               ============================================================ *@

            @if (Model.Torneo.Formato == FormatosTorneo.TodosContraTodos)
            {
                @if (Model.Clasificacion.Any())
                {
                    <div class="card" style="margin-bottom:24px;">
                        <div class="card-header"><h3 style="margin:0;">Clasificación</h3></div>
                        <div class="card-body" style="padding:0;">
                            @TablaClasificacion(Model.Clasificacion)
                        </div>
                    </div>
                }
                @ListaPartidos("Todos los Partidos", Model.PartidosFaseElim)
            }
            else if (Model.Torneo.Formato == FormatosTorneo.GruposYEliminacion)
            {
                @if (Model.Grupos.Any())
                {
                    <h2 style="margin-bottom:16px;font-size:0.88rem;opacity:0.55;letter-spacing:0.09em;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;">
                        Fase de Grupos
                    </h2>
                    @foreach (var grupo in Model.Grupos)
                    {
                        @if (grupo.Clasificacion.Any())
                        {
                            <div class="card" style="margin-bottom:12px;">
                                <div class="card-header">
                                    <h3 style="margin:0;">@grupo.NombreGrupo — Clasificación</h3>
                                </div>
                                <div class="card-body" style="padding:0;">
                                    @TablaClasificacion(grupo.Clasificacion)
                                </div>
                            </div>
                        }
                        @ListaPartidos($"Partidos — {grupo.NombreGrupo}", grupo.Partidos)
                    }
                }
                @if (Model.PartidosFaseElim.Any())
                {
                    <h2 style="margin:28px 0 14px;font-size:0.88rem;opacity:0.55;letter-spacing:0.09em;text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,0.07);padding-bottom:10px;">
                        Fase Eliminatoria
                    </h2>
                    @ListaPartidos("Partidos Eliminatorios", Model.PartidosFaseElim)
                }
            }
            else
            {
                @ListaPartidos("Partidos", Model.PartidosFaseElim)
            }
        }
    }
</div>

@{
    IHtmlContent TablaClasificacion(List<ClasificacionViewModel> tabla)
    {
        if (!tabla.Any())
            return new HtmlString("<div style='padding:20px;text-align:center;opacity:0.5;'>Sin partidos finalizados aún.</div>");

        var sb = new System.Text.StringBuilder();
        sb.Append("<div style='overflow-x:auto;'><table class='data-table' style='min-width:520px;'><thead><tr>");
        sb.Append("<th style='width:36px;text-align:center;'>#</th><th>Equipo</th>");
        sb.Append("<th title='Partidos Jugados' style='text-align:center;'>PJ</th>");
        sb.Append("<th title='Victorias' style='text-align:center;'>PG</th>");
        sb.Append("<th title='Empates' style='text-align:center;'>PE</th>");
        sb.Append("<th title='Derrotas' style='text-align:center;'>PP</th>");
        sb.Append("<th title='Goles Favor' style='text-align:center;'>GF</th>");
        sb.Append("<th title='Goles Contra' style='text-align:center;'>GC</th>");
        sb.Append("<th title='Diferencia' style='text-align:center;'>DG</th>");
        sb.Append("<th title='Puntos' style='text-align:center;'><strong style='color:var(--accent);'>Pts</strong></th>");
        sb.Append("</tr></thead><tbody>");

        foreach (var c in tabla)
        {
            string posStyle = c.Posicion == 1 ? "color:#FFD700;font-weight:700;" :
                              c.Posicion == 2 ? "color:#C0C0C0;font-weight:700;" :
                              c.Posicion == 3 ? "color:#CD7F32;font-weight:700;" : "opacity:0.6;";
            string dgStyle = c.DG > 0 ? "color:#a3ff12;" : c.DG < 0 ? "color:#ef4444;" : "";
            string dgTxt = (c.DG > 0 ? "+" : "") + c.DG;

            string escudo = !string.IsNullOrEmpty(c.Logo)
                ? $"<img src='{System.Net.WebUtility.HtmlEncode(c.Logo)}' style='width:22px;height:22px;object-fit:contain;border-radius:3px;flex-shrink:0;' />"
                : !string.IsNullOrEmpty(c.ColorPrimario)
                    ? $"<span style='display:inline-block;width:12px;height:12px;border-radius:2px;background:{c.ColorPrimario};flex-shrink:0;'></span>"
                    : "";

            string abrev = !string.IsNullOrEmpty(c.Abreviacion)
                ? $"<strong>{System.Net.WebUtility.HtmlEncode(c.NombreEquipo)}</strong><span style='font-size:0.72rem;opacity:0.35;margin-left:5px;'>[{System.Net.WebUtility.HtmlEncode(c.Abreviacion)}]</span>"
                : $"<strong>{System.Net.WebUtility.HtmlEncode(c.NombreEquipo)}</strong>";

            sb.Append("<tr>");
            sb.Append($"<td style='text-align:center;{posStyle}'>{c.Posicion}</td>");
            sb.Append($"<td><div style='display:flex;align-items:center;gap:8px;'>{escudo}{abrev}</div></td>");
            sb.Append($"<td style='text-align:center;'>{c.PJ}</td>");
            sb.Append($"<td style='text-align:center;'>{c.PG}</td>");
            sb.Append($"<td style='text-align:center;opacity:0.65;'>{c.PE}</td>");
            sb.Append($"<td style='text-align:center;opacity:0.65;'>{c.PP}</td>");
            sb.Append($"<td style='text-align:center;'>{c.GF}</td>");
            sb.Append($"<td style='text-align:center;opacity:0.65;'>{c.GC}</td>");
            sb.Append($"<td style='text-align:center;{dgStyle}'>{dgTxt}</td>");
            sb.Append($"<td style='text-align:center;'><strong style='color:var(--accent);'>{c.Pts}</strong></td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table></div>");
        return new HtmlString(sb.ToString());
    }

    IHtmlContent ListaPartidos(string titulo, List<PartidoResumenViewModel> partidos)
    {
        if (!partidos.Any())
            return new HtmlString(string.Empty);

        var pasados = partidos.Where(p => p.Estado == EstadosPartido.Finalizado).OrderByDescending(p => p.Fecha).ToList();
        var enCurso = partidos.Where(p => p.Estado == EstadosPartido.EnCurso).OrderBy(p => p.Fecha).ToList();
        var proximos = partidos.Where(p => p.Estado == EstadosPartido.Programado).OrderBy(p => p.Fecha).ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append($"<div class='card' style='margin-bottom:24px;'>");
        sb.Append($"<div class='card-header'><h3 style='margin:0;'>{System.Net.WebUtility.HtmlEncode(titulo)} <span style='font-weight:400;opacity:0.5;font-size:0.82rem;'>({partidos.Count})</span></h3></div>");
        sb.Append("<div class='card-body' style='padding:0;'>");

        void RenderGroup(string label, List<PartidoResumenViewModel> group, string? accent = null)
        {
            if (!group.Any()) return;
            sb.Append($"<div style='padding:7px 18px;font-size:0.68rem;opacity:0.5;letter-spacing:0.09em;border-bottom:1px solid rgba(255,255,255,0.06);{(accent != null ? $"color:{accent};" : "")}'>{label}</div>");
            foreach (var p in group)
            {
                bool fin = p.Estado == EstadosPartido.Finalizado;
                bool live = p.Estado == EstadosPartido.EnCurso;
                string resultado = fin ? $"{p.GolesLocal} – {p.GolesVisitante}" : live ? "LIVE" : "vs";
                string resultStyle = fin ? "font-size:1.4rem;font-weight:900;letter-spacing:-1px;" :
                                     live ? "font-size:0.85rem;font-weight:700;color:#f59e0b;" :
                                            "font-size:0.9rem;opacity:0.4;";
                bool localWins = fin && (p.GolesLocal ?? 0) > (p.GolesVisitante ?? 0);
                bool visitaWins = fin && (p.GolesVisitante ?? 0) > (p.GolesLocal ?? 0);
                string wL = localWins ? "font-weight:700;" : "opacity:0.75;";
                string wV = visitaWins ? "font-weight:700;" : "opacity:0.75;";
                string liveBg = live ? "background:rgba(245,158,11,0.04);" : "";

                string logoL = !string.IsNullOrEmpty(p.LogoLocal)
                    ? $"<img src='{System.Net.WebUtility.HtmlEncode(p.LogoLocal)}' style='width:26px;height:26px;object-fit:contain;flex-shrink:0;' />"
                    : !string.IsNullOrEmpty(p.ColorLocal)
                        ? $"<span style='display:inline-block;width:14px;height:14px;border-radius:3px;background:{p.ColorLocal};flex-shrink:0;'></span>" : "";
                string logoV = !string.IsNullOrEmpty(p.LogoVisitante)
                    ? $"<img src='{System.Net.WebUtility.HtmlEncode(p.LogoVisitante)}' style='width:26px;height:26px;object-fit:contain;flex-shrink:0;' />"
                    : !string.IsNullOrEmpty(p.ColorVisitante)
                        ? $"<span style='display:inline-block;width:14px;height:14px;border-radius:3px;background:{p.ColorVisitante};flex-shrink:0;'></span>" : "";

                string nmL = System.Net.WebUtility.HtmlEncode(p.AbrevLocal ?? p.NombreLocal);
                string nmV = System.Net.WebUtility.HtmlEncode(p.AbrevVisitante ?? p.NombreVisitante);
                string sedeHtml = !string.IsNullOrEmpty(p.Sede)
                    ? $"<div style='font-size:0.65rem;opacity:0.3;margin-top:2px;'>{System.Net.WebUtility.HtmlEncode(p.Sede)}</div>" : "";

                sb.Append($@"
                <div style='display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
                            padding:12px 20px;border-bottom:1px solid rgba(255,255,255,0.04);{liveBg}'>
                    <div style='display:flex;align-items:center;gap:8px;justify-content:flex-end;text-align:right;'>
                        <span style='font-size:0.88rem;{wL}'>{nmL}</span>{logoL}
                    </div>
                    <div style='text-align:center;padding:0 18px;min-width:90px;'>
                        <div style='{resultStyle}'>{resultado}</div>
                        <div style='font-size:0.68rem;opacity:0.4;margin-top:2px;'>{p.Fecha:dd/MM HH:mm}</div>
                        {sedeHtml}
                    </div>
                    <div style='display:flex;align-items:center;gap:8px;'>
                        {logoV}<span style='font-size:0.88rem;{wV}'>{nmV}</span>
                    </div>
                </div>");
            }
        }

        RenderGroup("EN CURSO ●", enCurso, "#f59e0b");
        RenderGroup("PRÓXIMOS", proximos);
        RenderGroup("RESULTADOS", pasados);

        sb.Append("</div></div>");
        return new HtmlString(sb.ToString());
    }
}
