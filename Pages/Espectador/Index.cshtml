@page
@model ControlTorneosFutbol.Pages.Espectador.IndexModel
@using ControlTorneosFutbol.Data.Entities
@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
}

<div class="page-container">

    <!-- BIENVENIDA -->
    <div class="page-header" style="margin-bottom:24px;">
        <div>
            <h1>¡Bienvenido, @Model.NombreUsuario!</h1>
            <p class="page-subtitle">Sigue tus equipos y torneos favoritos</p>
        </div>
    </div>

    <!-- STATS -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:32px;">
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:18px 20px;">
            <div style="font-size:0.7rem;opacity:0.45;letter-spacing:0.09em;margin-bottom:6px;">TORNEOS ACTIVOS</div>
            <div style="font-size:2.2rem;font-weight:800;color:var(--accent);">@Model.TorneosActivos</div>
        </div>
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:18px 20px;">
            <div style="font-size:0.7rem;opacity:0.45;letter-spacing:0.09em;margin-bottom:6px;">EQUIPOS PARTICIPANTES</div>
            <div style="font-size:2.2rem;font-weight:800;">@Model.TotalEquipos</div>
        </div>
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:18px 20px;">
            <div style="font-size:0.7rem;opacity:0.45;letter-spacing:0.09em;margin-bottom:6px;">PRÓXIMOS PARTIDOS</div>
            <div style="font-size:2.2rem;font-weight:800;">@Model.ProximosPartidos</div>
        </div>
    </div>

    <!-- EQUIPO FAVORITO -->
    @if (Model.EquipoFavorito != null)
    {
        var ef = Model.EquipoFavorito;
        string accentColor = ef.ColorPrimario ?? "var(--accent)";
        string bgFav = ef.ColorPrimario != null ? ef.ColorPrimario + "18" : "rgba(163,255,18,0.06)";
        string borderFav = ef.ColorPrimario ?? "rgba(163,255,18,0.25)";

        <div style="border:1px solid @borderFav;border-radius:16px;overflow:hidden;margin-bottom:32px;background:@bgFav;">

            <!-- Header favorito -->
            <div style="padding:18px 24px 14px;display:flex;align-items:center;gap:14px;border-bottom:1px solid rgba(255,255,255,0.06);">
                @{
                    string logoBg = ef.ColorPrimario != null ? ef.ColorPrimario + "25" : "rgba(255,255,255,0.08)";
                }
                <div style="width:56px;height:56px;border-radius:10px;background:@logoBg;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;">
                    @if (!string.IsNullOrEmpty(ef.Logo))
                    {
                        <img src="@ef.Logo" style="width:50px;height:50px;object-fit:contain;" />
                    }
                    else if (!string.IsNullOrEmpty(ef.Abreviacion))
                    {
                        <span style="font-weight:800;font-size:1rem;color:@accentColor;">@ef.Abreviacion</span>
                    }
                    else
                    {
                        <span style="font-size:1.6rem;opacity:0.3;">⚽</span>
                    }
                </div>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.09em;margin-bottom:3px;">MI EQUIPO FAVORITO</div>
                    <div style="font-size:1.3rem;font-weight:800;">@ef.Nombre</div>
                    @if (!string.IsNullOrEmpty(ef.Abreviacion))
                    {
                        <div style="font-size:0.75rem;opacity:0.4;">[@ef.Abreviacion]</div>
                    }
                </div>
                <div style="text-align:right;flex-shrink:0;">
                    @if (ef.Posicion.HasValue && ef.TotalEquipos.HasValue)
                    {
                        <div style="font-size:0.68rem;opacity:0.45;margin-bottom:2px;">POSICIÓN</div>
                        <div style="font-size:1.8rem;font-weight:900;color:@accentColor;">@ef.Posicion<span style="font-size:0.9rem;opacity:0.4;">/@ef.TotalEquipos</span></div>
                    }
                    @if (!string.IsNullOrEmpty(ef.NombreTorneoActivo))
                    {
                        <div style="font-size:0.72rem;opacity:0.5;margin-top:2px;">@ef.NombreTorneoActivo</div>
                    }
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0;">

                <!-- Próximo partido -->
                <div style="padding:16px 24px;border-right:1px solid rgba(255,255,255,0.06);">
                    <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:10px;">PRÓXIMO PARTIDO</div>
                    @if (ef.ProximoPartido != null)
                    {
                        var pp = ef.ProximoPartido;
                        <div style="font-size:0.82rem;font-weight:600;">
                            @(pp.EsLocal ? ef.Nombre : pp.NombreRival)
                            <span style="opacity:0.4;font-weight:400;margin:0 6px;">vs</span>
                            @(pp.EsLocal ? pp.NombreRival : ef.Nombre)
                        </div>
                        <div style="font-size:0.78rem;opacity:0.55;margin-top:5px;">
                            @pp.Fecha.ToString("dddd dd 'de' MMMM · HH:mm", new System.Globalization.CultureInfo("es-ES"))
                        </div>
                        @if (!string.IsNullOrEmpty(pp.Sede))
                        {
                            <div style="font-size:0.72rem;opacity:0.4;margin-top:3px;">📍 @pp.Sede</div>
                        }
                        <div style="margin-top:6px;">
                            <span class="badge" style="background:rgba(255,255,255,0.08);font-size:0.7rem;">
                                @(pp.EsLocal ? "Local" : "Visitante")
                            </span>
                        </div>
                    }
                    else
                    {
                        <div style="font-size:0.82rem;opacity:0.4;font-style:italic;">Sin partidos programados</div>
                    }
                </div>

                <!-- Últimos resultados -->
                <div style="padding:16px 24px;">
                    <div style="font-size:0.68rem;opacity:0.45;letter-spacing:0.08em;margin-bottom:10px;">ÚLTIMOS RESULTADOS</div>
                    @if (ef.UltimosResultados.Any())
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;">
                            @foreach (var r in ef.UltimosResultados)
                            {
                                string resColor = r.Resultado == "G" ? "var(--accent)" : r.Resultado == "P" ? "#ef4444" : "#f59e0b";
                                string resBg = r.Resultado == "G" ? "rgba(163,255,18,0.12)" : r.Resultado == "P" ? "rgba(239,68,68,0.12)" : "rgba(245,158,11,0.12)";
                                <div style="text-align:center;" title="@r.NombreRival — @r.GolesPropio:@r.GolesRival (@r.Fecha.ToString("dd/MM"))">
                                    <div style="width:36px;height:36px;border-radius:8px;background:@resBg;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.85rem;color:@resColor;">@r.Resultado</div>
                                    <div style="font-size:0.6rem;opacity:0.4;margin-top:2px;">@r.GolesPropio-@r.GolesRival</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="font-size:0.82rem;opacity:0.4;font-style:italic;">Sin resultados aún</div>
                    }
                </div>
            </div>

            @if (ef.TorneoActivoId.HasValue)
            {
                <div style="padding:12px 24px;border-top:1px solid rgba(255,255,255,0.06);display:flex;justify-content:flex-end;">
                    <a asp-page="/Espectador/TorneoDetalle" asp-route-id="@ef.TorneoActivoId" class="btn btn-secondary btn-sm">
                        Ver Torneo Completo →
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div style="border:1px dashed rgba(255,255,255,0.12);border-radius:12px;padding:20px 24px;margin-bottom:32px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
            <div>
                <div style="font-weight:600;margin-bottom:4px;">¿Tienes un equipo favorito?</div>
                <div style="font-size:0.82rem;opacity:0.5;">Configura tus preferencias para ver su próximo partido y resultados aquí.</div>
            </div>
            <a asp-page="/Espectador/Preferencias" class="btn btn-primary btn-sm" style="flex-shrink:0;">Configurar</a>
        </div>
    }

    <!-- TORNEOS -->
    @if (Model.TorneosRecientes.Any())
    {
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <h2 style="margin:0;font-size:1rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.08em;">Torneos</h2>
            <a asp-page="/Espectador/Torneos" style="font-size:0.8rem;opacity:0.5;text-decoration:none;color:inherit;">Ver todos →</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-bottom:32px;">
            @foreach (var t in Model.TorneosRecientes)
            {
                bool finalizado = t.Estado == EstadosTorneo.Finalizado;
                string borderTorneo = finalizado ? "rgba(255,255,255,0.07)" : "rgba(163,255,18,0.2)";
                string estadoBadgeBg = finalizado ? "rgba(255,255,255,0.08)" : "rgba(163,255,18,0.15)";
                string estadoBadgeColor = finalizado ? "inherit" : "var(--accent)";
                <div style="border:1px solid @borderTorneo;border-radius:12px;overflow:hidden;background:rgba(255,255,255,0.02);">
                    <div style="padding:14px 16px 10px;border-bottom:1px solid rgba(255,255,255,0.05);">
                        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                            <div style="font-weight:700;font-size:0.95rem;line-height:1.25;">@t.Nombre</div>
                            <span class="badge" style="background:@estadoBadgeBg;color:@estadoBadgeColor;flex-shrink:0;font-size:0.68rem;">@t.Estado</span>
                        </div>
                        <div style="font-size:0.72rem;opacity:0.45;margin-top:4px;">@t.NombreLiga · @t.NombreCategoria</div>
                    </div>
                    <div style="padding:10px 16px;display:flex;flex-direction:column;gap:5px;">
                        <div style="display:flex;justify-content:space-between;font-size:0.78rem;">
                            <span style="opacity:0.5;">Formato</span>
                            <span style="font-weight:500;">
                                @(t.Formato switch {
                                    FormatosTorneo.TodosContraTodos => "Liga",
                                    FormatosTorneo.EliminacionDirecta => "Eliminación",
                                    FormatosTorneo.GruposYEliminacion => "Grupos + Elim.",
                                    _ => t.Formato
                                })
                            </span>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:0.78rem;">
                            <span style="opacity:0.5;">Período</span>
                            <span>@t.FechaInicio.ToString("dd/MM/yy") — @t.FechaFin.ToString("dd/MM/yy")</span>
                        </div>
                        @if (t.NumeroEquiposInscritos > 0)
                        {
                            <div style="display:flex;justify-content:space-between;font-size:0.78rem;">
                                <span style="opacity:0.5;">Equipos</span>
                                <span>@t.NumeroEquiposInscritos</span>
                            </div>
                        }
                    </div>
                    <div style="padding:10px 16px;border-top:1px solid rgba(255,255,255,0.05);">
                        <a asp-page="/Espectador/TorneoDetalle" asp-route-id="@t.Id"
                           style="font-size:0.78rem;color:var(--accent);text-decoration:none;font-weight:600;">
                            Ver detalles →
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No hay torneos activos en este momento.</p>
            <p style="opacity:0.5;font-size:0.85rem;">Pronto habrá torneos disponibles.</p>
        </div>
    }

    <!-- ACCIONES RÁPIDAS -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:20px;">
            <div style="font-weight:700;margin-bottom:6px;">Mis Preferencias</div>
            <p style="font-size:0.82rem;opacity:0.5;margin:0 0 14px;">Elige tu equipo favorito y ajusta notificaciones.</p>
            <a asp-page="/Espectador/Preferencias" class="btn btn-primary btn-sm">Configurar</a>
        </div>
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:20px;">
            <div style="font-weight:700;margin-bottom:6px;">Explorar Torneos</div>
            <p style="font-size:0.82rem;opacity:0.5;margin:0 0 14px;">Descubre todos los torneos y sus clasificaciones.</p>
            <a asp-page="/Espectador/Torneos" class="btn btn-secondary btn-sm">Ver Torneos</a>
        </div>
    </div>

</div>
