@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var isAuthenticated = !string.IsNullOrEmpty(userName);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Torneos</title>
    
    @if (isAuthenticated)
    {
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
    }
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "authenticated" : "")">
    @if (isAuthenticated)
    {
        <!-- Layout con Sidebar -->
        <div class="app-container">
            @await Html.PartialAsync("_Sidebar")
            
            <div class="main-wrapper">
                <header class="top-bar">
                    <div class="top-bar-content">
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        <div class="user-info">
                            <span class="user-name">@userName</span>
                            <span class="user-role-badge">@userRole</span>
                        </div>
                    </div>
                </header>

                <main class="main-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Layout sin Sidebar (Login/Register) -->
        <header class="navbar-public">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    Control de Torneos
                </a>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Login">Iniciar Sesión</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn-register" asp-page="/Account/Register">Registrarse</a>
                    </li>
                </ul>
            </div>
        </header>

        <main class="main-content-public">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        <footer class="footer-public">
            <div class="container">
                <p>&copy; 2026 - Sistema de Control de Torneos de Fútbol</p>
            </div>
        </footer>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>