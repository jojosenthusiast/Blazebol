@page "{id:int}"
@model ControlTorneosFutbol.Pages.Arbitro.Partidos.VerificacionModel
@{
    ViewData["Title"] = "Verificación de Identidades";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Arbitro/Partidos/Index" class="back-link">← Volver a Mis Partidos</a>
            <h1>Verificación de Identidades</h1>
            <p class="page-subtitle">
                @Model.NombreLocal vs @Model.NombreVisitante —
                @Model.FechaPartido.ToString("dd/MM/yyyy HH:mm")
                @if (!string.IsNullOrEmpty(Model.Sede))
                {
                    <span>· @Model.Sede</span>
                }
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }
    else
    {
        <!-- PANEL DE VERIFICACIÓN PRE-PARTIDO -->
        <div class="card" style="margin-bottom: 24px;">
            <div class="card-header" style="display:flex;align-items:center;gap:10px;">
                <i class="bi bi-clipboard2-check" style="font-size:1.1rem;"></i>
                <h3 style="margin:0;">Verificación Pre-Partido</h3>
            </div>
            <div class="card-body" style="padding: 0;">
                @foreach (var check in Model.Checks)
                {
                    <div style="display:flex;align-items:flex-start;gap:14px;padding:14px 20px;border-bottom:1px solid var(--color-border);">
                        @if (check.Pasa)
                        {
                            <i class="bi bi-check-circle-fill" style="font-size:1.2rem;color:#34c759;flex-shrink:0;margin-top:2px;"></i>
                        }
                        else
                        {
                            <i class="bi bi-x-circle-fill" style="font-size:1.2rem;color:#ff3b30;flex-shrink:0;margin-top:2px;"></i>
                        }
                        <div>
                            <div style="font-weight:600;font-size:0.9rem;">@check.Nombre</div>
                            <div style="font-size:0.8rem;opacity:0.65;margin-top:2px;">@check.Descripcion</div>
                        </div>
                    </div>
                }

                <!-- VEREDICTO FINAL -->
                @if (Model.PuedeProceeder)
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;background:rgba(52,199,89,0.08);border-top:2px solid rgba(52,199,89,0.3);">
                        <i class="bi bi-shield-check-fill" style="font-size:1.5rem;color:#34c759;flex-shrink:0;"></i>
                        <div>
                            <div style="font-weight:700;color:#34c759;">El partido puede proceder</div>
                            <div style="font-size:0.8rem;opacity:0.7;margin-top:2px;">Todos los requisitos previos están cumplidos</div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex;align-items:center;gap:12px;padding:16px 20px;background:rgba(255,59,48,0.08);border-top:2px solid rgba(255,59,48,0.3);">
                        <i class="bi bi-shield-x-fill" style="font-size:1.5rem;color:#ff3b30;flex-shrink:0;"></i>
                        <div>
                            <div style="font-weight:700;color:#ff3b30;">El partido NO puede proceder</div>
                            <div style="font-size:0.8rem;opacity:0.7;margin-top:2px;">
                                @Model.Checks.Count(c => !c.Pasa) condición(es) sin cumplir — ver detalle arriba
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">

            <!-- EQUIPO LOCAL -->
            <div class="card">
                <div class="card-header">
                    <h2 style="margin: 0; font-size: 1.1rem;">@Model.NombreLocal <span style="font-size: 0.8rem; opacity: 0.6;">(Local)</span></h2>
                </div>
                <div class="card-body">

                    @if (Model.EntrenadoresLocal.Any())
                    {
                        <h4 style="color: var(--accent); margin-bottom: 8px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Cuerpo Técnico</h4>
                        <table class="data-table" style="margin-bottom: 20px; font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Rol</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.EntrenadoresLocal)
                                {
                                    <tr>
                                        <td>@e.NombreCompleto</td>
                                        <td>@e.Rol</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <h4 style="color: var(--accent); margin-bottom: 8px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Jugadores (@Model.JugadoresLocal.Count)</h4>
                    @if (Model.JugadoresLocal.Any())
                    {
                        <table class="data-table" style="font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Nombre</th>
                                    <th>Posición</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in Model.JugadoresLocal)
                                {
                                    <tr>
                                        <td><strong>@j.NumeroCamiseta</strong></td>
                                        <td>@j.NombreCompleto</td>
                                        <td>@j.Rol</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="opacity: 0.6; font-size: 0.9rem;">Sin jugadores inscritos</p>
                    }
                </div>
            </div>

            <!-- EQUIPO VISITANTE -->
            <div class="card">
                <div class="card-header">
                    <h2 style="margin: 0; font-size: 1.1rem;">@Model.NombreVisitante <span style="font-size: 0.8rem; opacity: 0.6;">(Visitante)</span></h2>
                </div>
                <div class="card-body">

                    @if (Model.EntrenadoresVisitante.Any())
                    {
                        <h4 style="color: var(--accent); margin-bottom: 8px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Cuerpo Técnico</h4>
                        <table class="data-table" style="margin-bottom: 20px; font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Rol</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.EntrenadoresVisitante)
                                {
                                    <tr>
                                        <td>@e.NombreCompleto</td>
                                        <td>@e.Rol</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <h4 style="color: var(--accent); margin-bottom: 8px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Jugadores (@Model.JugadoresVisitante.Count)</h4>
                    @if (Model.JugadoresVisitante.Any())
                    {
                        <table class="data-table" style="font-size: 0.9rem;">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Nombre</th>
                                    <th>Posición</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in Model.JugadoresVisitante)
                                {
                                    <tr>
                                        <td><strong>@j.NumeroCamiseta</strong></td>
                                        <td>@j.NombreCompleto</td>
                                        <td>@j.Rol</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="opacity: 0.6; font-size: 0.9rem;">Sin jugadores inscritos</p>
                    }
                </div>
            </div>

        </div>

        <div style="margin-top: 24px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <a asp-page="/Arbitro/Partidos/Jugadores" asp-route-id="@Model.PartidoId"
               class="btn btn-info btn-icon">
                <i class="bi bi-people"></i> Ver Lista de Jugadores
            </a>
            <a asp-page="/Arbitro/Partidos/Index" class="btn btn-link btn-icon">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            @if (Model.PuedeProceeder)
            {
                <form method="post" asp-page-handler="IniciarPartido" style="display:inline;">
                    <input type="hidden" name="id" value="@Model.PartidoId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-icon"
                            style="background:var(--color-accent);color:#000;font-weight:700;padding:10px 24px;border:none;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:8px;"
                            onclick="return confirm('¿Iniciar el partido ahora? Esta acción no se puede deshacer.')">
                        <i class="bi bi-play-circle-fill"></i> Iniciar Partido
                    </button>
                </form>
            }
        </div>
    }
</div>
