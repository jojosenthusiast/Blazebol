@page
@model DashboardModel
@{
    ViewData["Title"] = "Mi Dashboard - Árbitro";
    Layout = "_Layout";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Mi Dashboard de Árbitro</h1>
        <p class="dashboard-subtitle">Bienvenido, @Model.NombreCompleto</p>
    </div>

    <div class="referee-status-card" style="display:flex;align-items:center;gap:16px;background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:12px;padding:24px;margin-bottom:24px;">
        <i class="bi bi-clipboard2-check-fill" style="font-size:3rem;color:var(--color-accent);flex-shrink:0;"></i>
        <div>
            <h3 style="margin:0 0 8px;">Estado de Cuenta</h3>
            @if (Model.EstadoAprobacion == "Aprobado")
            {
                <span class="badge badge-activo"><i class="bi bi-check-circle"></i> @Model.EstadoAprobacion</span>
                <p class="status-message" style="margin-top:8px;color:var(--color-text-secondary);">Tu cuenta ha sido aprobada. Ya puedes arbitrar partidos.</p>
            }
            else if (Model.EstadoAprobacion == "Pendiente")
            {
                <span class="badge badge-warning"><i class="bi bi-clock"></i> @Model.EstadoAprobacion</span>
                <p class="status-message" style="margin-top:8px;color:var(--color-text-secondary);">Tu cuenta está siendo revisada por un administrador.</p>
            }
            else
            {
                <span class="badge badge-danger"><i class="bi bi-x-circle"></i> @Model.EstadoAprobacion</span>
                <p class="status-message" style="margin-top:8px;color:var(--color-text-secondary);">Tu solicitud ha sido rechazada. Contacta al administrador para más información.</p>
            }
        </div>
    </div>

    @if (Model.EstadoAprobacion == "Aprobado")
    {
        <div class="stats-grid">
            <div class="stat-card">
                <i class="bi bi-calendar-check-fill stat-icon" style="color:var(--color-info);"></i>
                <div class="stat-content">
                    <h3>@Model.PartidosArbitrados</h3>
                    <p>Partidos Arbitrados</p>
                </div>
            </div>
            <div class="stat-card stat-active">
                <i class="bi bi-calendar-event stat-icon" style="color:var(--color-success);"></i>
                <div class="stat-content">
                    <h3>@Model.ProximosPartidos.Count</h3>
                    <p>Próximos Asignados</p>
                </div>
            </div>
        </div>

        <div class="dashboard-actions">
            <h2>Acciones Rápidas</h2>
            <div class="action-cards">
                <a asp-page="/Arbitro/Partidos/Index" class="action-card">
                    <i class="bi bi-calendar-event action-icon" style="color:var(--color-accent);"></i>
                    <h3>Mis Partidos</h3>
                    <p>Ver todos los partidos asignados</p>
                </a>
                <a asp-page="/Calendario/Index" class="action-card">
                    <i class="bi bi-calendar3 action-icon" style="color:var(--color-info);"></i>
                    <h3>Calendario</h3>
                    <p>Vista mensual de todos los partidos</p>
                </a>
            </div>
        </div>

        @if (Model.ProximosPartidos.Any())
        {
            <div style="margin-top:24px;">
                <h2>Próximos Partidos Asignados</h2>
                <div class="card" style="margin-top:12px;">
                    <div class="card-body" style="padding:0;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Fecha y Hora</th>
                                    <th>Torneo</th>
                                    <th>Partido</th>
                                    <th>Sede</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.ProximosPartidos)
                                {
                                    <tr>
                                        <td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td style="font-size:0.85rem;opacity:0.8;">@p.NombreTorneo</td>
                                        <td><strong>@p.NombreLocal</strong> vs <strong>@p.NombreVisitante</strong></td>
                                        <td style="font-size:0.85rem;opacity:0.8;">@(p.Sede ?? "—")</td>
                                        <td>
                                            <a asp-page="/Arbitro/Partidos/Index" class="btn btn-sm btn-info btn-icon">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state" style="margin-top:24px;">
                <i class="bi bi-calendar-x empty-icon"></i>
                <p>No tienes partidos asignados próximamente.</p>
                <p style="font-size:0.85rem;opacity:0.6;">Los partidos que te asigne el administrador aparecerán aquí.</p>
            </div>
        }
    }
</div>
