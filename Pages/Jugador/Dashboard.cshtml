@page
@model DashboardModel
@{
    ViewData["Title"] = "Mi Dashboard - Jugador";
    Layout = "_Layout";
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Mi Dashboard de Jugador</h1>
        <p class="dashboard-subtitle">Bienvenido, @Model.NombreCompleto</p>
    </div>

    @if (!Model.TieneEquipoEnTorneoActivo)
    {
        @if (Model.TieneSolicitudPendiente)
        {
            <div class="alert alert-warning" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                <i class="bi bi-hourglass-split" style="font-size:1.6rem;flex-shrink:0;"></i>
                <div style="flex:1;min-width:180px;">
                    <strong>Solicitudes en espera</strong>
                    <div style="font-size:0.85rem;margin-top:4px;opacity:0.85;">
                        Tienes solicitudes e invitaciones pendientes. Acepta una invitación para participar.
                    </div>
                </div>
                <a asp-page="/Jugador/Solicitudes" class="btn btn-warning btn-sm btn-icon">
                    <i class="bi bi-envelope-check"></i> Ver Solicitudes
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
                <i class="bi bi-dribbble" style="font-size:1.6rem;flex-shrink:0;"></i>
                <div style="flex:1;min-width:180px;">
                    <strong>No estás inscrito en ningún torneo activo</strong>
                    <div style="font-size:0.85rem;margin-top:4px;opacity:0.85;">
                        Busca un equipo y envía una solicitud, o espera una invitación de un entrenador.
                    </div>
                </div>
                <a asp-page="/Jugador/BuscarEquipos" class="btn btn-info btn-sm btn-icon">
                    <i class="bi bi-search"></i> Buscar Equipos
                </a>
            </div>
        }
    }

    <div class="player-info-card">
        <div style="display:flex;align-items:center;gap:20px;">
            <i class="bi bi-person-circle" style="font-size:3rem;color:var(--color-accent);flex-shrink:0;"></i>
            <div>
                <h2>@Model.NombreCompleto</h2>
                @if (!string.IsNullOrEmpty(Model.EquipoActual))
                {
                    <p class="team-name">
                        <i class="bi bi-shield-fill text-accent"></i>
                        <strong> @Model.EquipoActual</strong>
                        @if (Model.TieneEquipoEnTorneoActivo)
                        {
                            <span class="badge badge-activo" style="margin-left:8px;">Activo</span>
                        }
                    </p>
                    @if (!string.IsNullOrEmpty(Model.TorneoActual))
                    {
                        <p style="font-size:0.85rem;opacity:0.7;margin-top:4px;">
                            <i class="bi bi-trophy"></i> @Model.TorneoActual
                        </p>
                    }
                    <div style="display:flex;gap:16px;margin-top:6px;flex-wrap:wrap;">
                        @if (!string.IsNullOrEmpty(Model.PosicionActual))
                        {
                            <span style="font-size:0.82rem;opacity:0.7;">
                                <strong>Posición:</strong> @Model.PosicionActual
                            </span>
                        }
                        @if (Model.NumeroCamisetaActual.HasValue)
                        {
                            <span style="font-size:0.82rem;opacity:0.7;">
                                <strong>Camiseta #:</strong> @Model.NumeroCamisetaActual
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="no-team text-muted">Sin equipo asignado</p>
                }
                <span class="badge badge-jugador" style="margin-top:8px;">Jugador</span>
            </div>
        </div>
    </div>

    @if (Model.TieneEquipoEnTorneoActivo || Model.ProximosPartidos.Any())
    {
        <div class="recent-section">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <h2 style="margin:0;">Próximos Partidos</h2>
                <a asp-page="/Calendario/Index" class="btn btn-sm btn-info btn-icon">
                    <i class="bi bi-calendar3"></i> Ver Calendario
                </a>
            </div>
            @if (Model.ProximosPartidos.Any())
            {
                <div class="match-mini-list">
                    @foreach (var p in Model.ProximosPartidos)
                    {
                        <div class="match-mini-card">
                            <div class="match-mini-dot" style="background:@p.ColorTorneo;"></div>
                            <div class="match-mini-body">
                                <div class="match-mini-teams"><strong>@p.AbrevLocal</strong> vs <strong>@p.AbrevVisitante</strong></div>
                                <div class="match-mini-meta">@p.Fecha.ToString("dd/MM HH:mm") · @p.NombreTorneo@(p.Sede != null ? " · " + p.Sede : "")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:16px;">
                    <i class="bi bi-calendar-x empty-icon"></i>
                    <p>No tienes partidos próximos programados</p>
                </div>
            }
        </div>
    }

    <div class="dashboard-actions">
        <h2>Acciones Rápidas</h2>
        <div class="action-cards">
            <a asp-page="/Jugador/Perfil" class="action-card">
                <i class="bi bi-person-circle action-icon" style="color:var(--color-accent);"></i>
                <h3>Mi Perfil</h3>
                <p>Editar información personal</p>
            </a>

            <a asp-page="/Jugador/Solicitudes" class="action-card">
                <i class="bi bi-envelope-check action-icon" style="color:var(--color-info);"></i>
                <h3>Mis Solicitudes</h3>
                <p>Invitaciones recibidas y solicitudes enviadas</p>
            </a>

            <a asp-page="/Jugador/Partidos/Index"
               class="action-card @(!Model.TieneEquipoEnTorneoActivo ? "action-card-disabled" : "")">
                <i class="bi bi-calendar-event action-icon" style="color:var(--color-warning);"></i>
                <h3>Mis Partidos</h3>
                <p>Calendario y resultados de tu equipo</p>
            </a>

            @if (!Model.TieneEquipoEnTorneoActivo)
            {
                <a asp-page="/Jugador/BuscarEquipos" class="action-card">
                    <i class="bi bi-search action-icon" style="color:var(--color-success);"></i>
                    <h3>Buscar Equipos</h3>
                    <p>Encuentra un equipo para unirte</p>
                </a>
            }
        </div>
    </div>
</div>
