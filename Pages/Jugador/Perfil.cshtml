@page
@model ControlTorneosFutbol.Pages.Jugador.PerfilModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Jugador/Dashboard" class="back-link">← Volver al Dashboard</a>
            <h1>Mi Perfil</h1>
            <p class="page-subtitle">@Model.NombreCompleto</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <div class="form-container" style="max-width:560px">
        <form method="post" class="form-horizontal">

            <div class="form-section">
                <h3 class="form-section-title">Información Personal</h3>

                <div class="form-group">
                    <label asp-for="Input.Nombre" class="required"></label>
                    <input asp-for="Input.Nombre" class="form-control" />
                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ApellidoPaterno" class="required"></label>
                    <input asp-for="Input.ApellidoPaterno" class="form-control" />
                    <span asp-validation-for="Input.ApellidoPaterno" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ApellidoMaterno"></label>
                    <input asp-for="Input.ApellidoMaterno" class="form-control" />
                    <span asp-validation-for="Input.ApellidoMaterno" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Telefono"></label>
                    <input asp-for="Input.Telefono" class="form-control" type="tel" />
                    <span asp-validation-for="Input.Telefono" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Datos de Jugador</h3>

                <div class="form-group">
                    <label asp-for="Input.PosicionPreferida"></label>
                    <select asp-for="Input.PosicionPreferida" class="form-control">
                        <option value="">-- Sin posición definida --</option>
                        <option value="Portero">Portero</option>
                        <option value="Defensa">Defensa</option>
                        <option value="Medio">Medio</option>
                        <option value="Delantero">Delantero</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Input.NumeroCamiseta"></label>
                    <input asp-for="Input.NumeroCamiseta" class="form-control"
                           type="number" min="1" max="99" />
                    <span asp-validation-for="Input.NumeroCamiseta" class="text-danger"></span>
                    <small class="form-hint">Número de camiseta preferido (puede diferir del asignado por equipo)</small>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a asp-page="/Jugador/Dashboard" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
