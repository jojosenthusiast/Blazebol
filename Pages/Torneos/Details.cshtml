@page "{id:int}"
@model ControlTorneosFutbol.Pages.Torneos.DetailsModel
@{
    ViewData["Title"] = Model.Torneo.Nombre;
    Layout = "_Layout";
    var t = Model.Torneo;
}

<!-- ========== NAVBAR ========== -->
<nav class="navbar-public-landing" id="detNavbar">
    <div class="nav-container">
        <a asp-page="/Torneos/Index" class="btn-back-torneo">
            <i class="bi bi-arrow-left"></i> Todos los torneos
        </a>
        <a href="/" class="brand-logo-link" style="margin:0 auto;">
            <img src="~/images/logo.png" alt="Blazebol" class="brand-logo-img" onerror="this.style.display='none'" />
            <span class="brand-logo-text">Blaze<span class="accent-dot">bol</span></span>
        </a>
        <div class="nav-cta-group">
            @if (Model.IsAuthenticated)
            {
                <a asp-page="@Model.DashboardPage" class="btn-nav-dashboard">Mi Dashboard</a>
            }
            else
            {
                <a asp-page="/Account/Login"   class="btn-nav-login">Iniciar sesión</a>
                <a asp-page="/Account/Register" class="btn-nav-register">Registrarse</a>
            }
        </div>
    </div>
</nav>

<!-- ========== HERO DEL TORNEO ========== -->
<div class="torneo-hero-header" style="@(!string.IsNullOrEmpty(t.ImagenUrl) ? $"background:linear-gradient(rgba(0,0,0,0.7),rgba(0,0,0,0.85)),url('{t.ImagenUrl}') center/cover no-repeat;" : "")">
    @if (!string.IsNullOrEmpty(t.LogoUrl))
    {
        <img src="@t.LogoUrl" alt="Logo @t.Nombre" class="torneo-hero-logo" />
    }
    else
    {
        <div style="width:80px;height:80px;background:rgba(163,255,18,0.1);border:2px solid var(--color-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto var(--spacing-lg);font-size:2rem;">⚽</div>
    }
    <h1 class="torneo-hero-title">@t.Nombre</h1>
    <p class="torneo-hero-dates">
        @t.FechaInicio.ToString("dd MMMM yyyy") — @t.FechaFin.ToString("dd MMMM yyyy")
    </p>
    <div style="margin-top:12px;">
        <span class="torneo-badge-card @(t.Estado == "Activo" ? "torneo-badge--activo" : t.Estado == "Finalizado" ? "torneo-badge--finalizado" : "torneo-badge--proximo")" style="position:static;">
            @(t.Estado == "Activo" ? "En curso" : t.Estado == "Finalizado" ? "Finalizado" : "Próximamente")
        </span>
    </div>
</div>

<!-- ========== SUB-NAV DEL TORNEO ========== -->
<nav class="torneo-sub-nav">
    <div class="nav-container">
        <a href="#info"          class="torneo-sub-link active" data-tab="info">
            <i class="bi bi-info-circle"></i> Torneo
        </a>
        <a href="#equipos-tab"   class="torneo-sub-link" data-tab="equipos">
            <i class="bi bi-people"></i> Equipos
        </a>
        @if (t.Clasificacion.Any())
        {
            <a href="#clasificacion-tab" class="torneo-sub-link" data-tab="clasificacion">
                <i class="bi bi-bar-chart-line"></i> Clasificación
            </a>
        }
        <a href="#partidos-tab"  class="torneo-sub-link" data-tab="partidos">
            <i class="bi bi-calendar3"></i> Partidos
        </a>
        @if (!Model.IsAuthenticated)
        {
            <a asp-page="/Account/Register" class="torneo-sub-link torneo-sub-link--inscribirse">
                <i class="bi bi-person-plus"></i> Inscribirse
            </a>
        }
        else
        {
            <a asp-page="@Model.DashboardPage" class="torneo-sub-link torneo-sub-link--inscribirse">
                <i class="bi bi-speedometer2"></i> Mi Dashboard
            </a>
        }
    </div>
</nav>

<!-- ========== CONTENIDO PRINCIPAL ========== -->
<div style="background:var(--color-bg-primary);">
    <div class="torneo-detail-layout">

        <!-- MAIN -->
        <div class="torneo-detail-main">

            <!-- Descripción -->
            <div id="info" style="margin-bottom:var(--spacing-3xl);">
                @if (!string.IsNullOrEmpty(t.DescripcionCompleta))
                {
                    <h2 style="font-size:var(--text-3xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:12px;">
                        <i class="bi bi-info-circle-fill" style="color:var(--color-accent);"></i> Sobre este torneo
                    </h2>
                    <div style="font-size:var(--text-lg);line-height:1.8;color:var(--color-text-secondary);">
                        @Html.Raw(t.DescripcionCompleta)
                    </div>
                }
                else
                {
                    <div style="background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:var(--spacing-2xl);text-align:center;color:var(--color-text-muted);">
                        <i class="bi bi-file-text" style="font-size:2.5rem;display:block;margin-bottom:16px;color:rgba(163,255,18,0.3);"></i>
                        <p>El organizador no ha agregado una descripción para este torneo aún.</p>
                    </div>
                }
            </div>

            <!-- Galería -->
            @if (t.ImagenesGaleria.Any())
            {
                <div style="margin-bottom:var(--spacing-3xl);">
                    <h2 style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:10px;">
                        <i class="bi bi-images" style="color:var(--color-accent);"></i> Galería
                    </h2>
                    <div class="galeria-grid-public">
                        @foreach (var img in t.ImagenesGaleria.Take(6))
                        {
                            <div class="galeria-item-public">
                                <img src="@img" alt="Galería @t.Nombre" loading="lazy"
                                     onerror="this.parentElement.style.display='none'" />
                            </div>
                        }
                    </div>

                    @{
                        var frases = new[] { t.Frase1, t.Frase2, t.Frase3 }.Where(f => !string.IsNullOrEmpty(f)).ToList();
                        string[] icons = { "bi-stars", "bi-people-fill", "bi-heart-fill" };
                    }
                    @if (frases.Any())
                    {
                        <div class="frases-grid" style="margin-top:var(--spacing-2xl);">
                            @for (int i = 0; i < frases.Count; i++)
                            {
                                <div class="frase-item">
                                    <i class="bi @icons[i % 3]"></i>
                                    <p>@frases[i]</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Tabs: Equipos / Partidos -->
            <div id="equipos-tab" style="margin-bottom:var(--spacing-3xl);">
                <h2 style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:10px;">
                    <i class="bi bi-people-fill" style="color:var(--color-accent);"></i> Equipos inscritos
                    <span style="font-size:var(--text-base);font-weight:400;color:var(--color-text-muted);margin-left:auto;">@t.EquiposInscritos@(t.EquiposMaximo.HasValue ? $" / {t.EquiposMaximo}" : "")</span>
                </h2>
                @if (t.Equipos.Any())
                {
                    <div class="equipos-inscritos-grid">
                        @foreach (var eq in t.Equipos)
                        {
                            <a asp-page="/Torneos/Equipo" asp-route-torneoId="@t.Id" asp-route-equipoId="@eq.Id"
                               class="equipo-card-public" style="text-decoration:none;border:1px solid var(--color-border);border-radius:var(--radius-lg);">
                                @if (!string.IsNullOrEmpty(eq.Logo))
                                {
                                    <img src="@eq.Logo" alt="@eq.Nombre" class="equipo-logo-public"
                                         onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <div class="equipo-logo-placeholder">@(eq.Abreviacion ?? eq.Nombre.Substring(0,Math.Min(3,eq.Nombre.Length)).ToUpper())</div>
                                }
                                <div>
                                    <div class="equipo-card-name">@eq.Nombre</div>
                                    @if (!string.IsNullOrEmpty(eq.EntrenadorNombre))
                                    {
                                        <div class="equipo-card-entrenador">@eq.EntrenadorNombre</div>
                                    }
                                    <div style="font-size:11px;color:var(--color-accent);margin-top:4px;">Ver plantilla <i class="bi bi-arrow-right"></i></div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p style="color:var(--color-text-muted);padding:24px 0;">No hay equipos inscritos aún.</p>
                }
            </div>

            <!-- Clasificación -->
            @if (t.Clasificacion.Any())
            {
                <div id="clasificacion-tab" style="margin-bottom:var(--spacing-3xl);">
                    <h2 style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:10px;">
                        <i class="bi bi-bar-chart-line-fill" style="color:var(--color-accent);"></i> Clasificación
                    </h2>
                    <div style="overflow-x:auto;">
                        <table class="clasificacion-publica-table">
                            <thead>
                                <tr>
                                    <th style="width:36px;">#</th>
                                    <th style="text-align:left;">Equipo</th>
                                    <th title="Partidos jugados">PJ</th>
                                    <th title="Ganados">G</th>
                                    <th title="Empatados">E</th>
                                    <th title="Perdidos">P</th>
                                    <th title="Goles a favor">GF</th>
                                    <th title="Goles en contra">GC</th>
                                    <th title="Diferencia de goles">DG</th>
                                    <th title="Puntos" style="color:var(--color-accent);">Pts</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cls in t.Clasificacion)
                                {
                                    <tr>
                                        <td><span class="cls-pos">@cls.Posicion</span></td>
                                        <td style="text-align:left;">
                                            <div style="display:flex;align-items:center;gap:10px;">
                                                @if (!string.IsNullOrEmpty(cls.EquipoLogo))
                                                {
                                                    <img src="@cls.EquipoLogo" alt="@cls.EquipoNombre"
                                                         style="width:24px;height:24px;object-fit:contain;border-radius:4px;"
                                                         onerror="this.style.display='none'" />
                                                }
                                                <a asp-page="/Torneos/Equipo" asp-route-torneoId="@t.Id" asp-route-equipoId="@cls.EquipoId"
                                                   style="color:var(--color-text-primary);text-decoration:none;font-weight:var(--font-semibold);">
                                                    @(cls.EquipoAbreviacion ?? cls.EquipoNombre)
                                                </a>
                                            </div>
                                        </td>
                                        <td>@cls.PJ</td>
                                        <td>@cls.G</td>
                                        <td>@cls.E</td>
                                        <td>@cls.P</td>
                                        <td>@cls.GF</td>
                                        <td>@cls.GC</td>
                                        <td style="color:@(cls.GD > 0 ? "var(--color-accent)" : cls.GD < 0 ? "#ef4444" : "var(--color-text-muted)");">
                                            @(cls.GD > 0 ? $"+{cls.GD}" : cls.GD.ToString())
                                        </td>
                                        <td style="font-weight:var(--font-bold);color:var(--color-accent);">@cls.Pts</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Patrocinadores -->
            @if (t.Patrocinadores.Any())
            {
                <div style="margin-bottom:var(--spacing-3xl);">
                    <h2 style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:10px;">
                        <i class="bi bi-award" style="color:var(--color-accent);"></i> Patrocinadores
                    </h2>
                    <div class="patrocinadores-grid-public">
                        @foreach (var logo in t.Patrocinadores)
                        {
                            <div class="patrocinador-item-public">
                                <img src="@logo" alt="Patrocinador" loading="lazy"
                                     onerror="this.parentElement.style.display='none'" />
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Partidos -->
            <div id="partidos-tab" style="margin-bottom:var(--spacing-3xl);">
                <h2 style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-text-primary);margin-bottom:var(--spacing-lg);display:flex;align-items:center;gap:10px;">
                    <i class="bi bi-calendar3" style="color:var(--color-accent);"></i> Partidos
                </h2>
                @if (!t.Partidos.Any())
                {
                    <p style="color:var(--color-text-muted);padding:24px 0;">No hay partidos programados aún.</p>
                }
                else
                {
                    <div class="partidos-list-public">
                        @foreach (var p in t.Partidos)
                        {
                            <div style="background:var(--color-bg-card);border:1px solid @(p.EsEnCurso ? "var(--color-accent)" : "var(--color-border)");border-radius:var(--radius-lg);overflow:hidden;">
                                <!-- Fila: fecha + sede + estado -->
                                <div style="padding:8px var(--spacing-lg);background:var(--color-bg-elevated);display:flex;align-items:center;gap:12px;font-size:var(--text-sm);color:var(--color-text-muted);">
                                    <i class="bi bi-calendar3"></i>
                                    <span>@p.Fecha.ToString("dd MMM yyyy · HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(p.Sede))
                                    {
                                        <span>· @p.Sede</span>
                                    }
                                    <span style="margin-left:auto;padding:2px 10px;border-radius:99px;font-size:11px;font-weight:600;
                                          background:@(p.EsFinalizado ? "rgba(163,255,18,0.12)" : p.EsEnCurso ? "rgba(255,193,7,0.15)" : "rgba(100,116,139,0.15)");
                                          color:@(p.EsFinalizado ? "var(--color-accent)" : p.EsEnCurso ? "#ffc107" : "var(--color-text-muted)");">
                                        @(p.EsFinalizado ? "Finalizado" : p.EsEnCurso ? "En curso" : "Programado")
                                    </span>
                                </div>
                                <!-- Fila: equipos + marcador -->
                                <div class="partido-item-public">
                                    <div class="equipo-side">
                                        @if (!string.IsNullOrEmpty(p.EquipoLocalLogo))
                                        {
                                            <img src="@p.EquipoLocalLogo" alt="@p.EquipoLocalNombre"
                                                 style="width:32px;height:32px;object-fit:contain;border-radius:4px;"
                                                 onerror="this.style.display='none'" />
                                        }
                                        <span class="equipo-side-name">@(p.EquipoLocalAbreviacion ?? p.EquipoLocalNombre)</span>
                                    </div>
                                    <div class="partido-centro">
                                        @if (p.EsFinalizado && p.GolesLocal.HasValue)
                                        {
                                            <div class="partido-score">@p.GolesLocal — @p.GolesVisitante</div>
                                        }
                                        else
                                        {
                                            <div class="partido-score" style="font-size:var(--text-lg);color:var(--color-text-muted);">vs</div>
                                        }
                                    </div>
                                    <div class="equipo-side visitante">
                                        <span class="equipo-side-name">@(p.EquipoVisitanteAbreviacion ?? p.EquipoVisitanteNombre)</span>
                                        @if (!string.IsNullOrEmpty(p.EquipoVisitanteLogo))
                                        {
                                            <img src="@p.EquipoVisitanteLogo" alt="@p.EquipoVisitanteNombre"
                                                 style="width:32px;height:32px;object-fit:contain;border-radius:4px;"
                                                 onerror="this.style.display='none'" />
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- SIDEBAR -->
        <div class="torneo-detail-sidebar">

            <!-- Ubicación -->
            @if (!string.IsNullOrEmpty(t.Ubicacion))
            {
                <div class="torneo-sidebar-card">
                    <div class="torneo-sidebar-label"><i class="bi bi-geo-alt-fill"></i> Ubicación</div>
                    <div class="torneo-sidebar-value">@t.Ubicacion</div>
                    @if (!string.IsNullOrEmpty(t.DireccionSede))
                    {
                        <div class="torneo-sidebar-sub">@t.DireccionSede</div>
                    }
                </div>
            }

            <!-- CTA: Inscribirse -->
            <div class="torneo-sidebar-card">
                @if (!Model.IsAuthenticated)
                {
                    <a asp-page="/Account/Register" class="btn-inscribirse-big">
                        <i class="bi bi-person-plus-fill"></i> Inscribirse al torneo
                    </a>
                    <p style="font-size:var(--text-sm);color:var(--color-text-muted);text-align:center;">
                        Necesitas una cuenta para inscribirte.
                        <a asp-page="/Account/Login" style="color:var(--color-accent);">Iniciar sesión</a>
                    </p>
                }
                else
                {
                    <a asp-page="@Model.DashboardPage" class="btn-inscribirse-big">
                        <i class="bi bi-speedometer2"></i> Ir a mi Dashboard
                    </a>
                }
            </div>

            <!-- Archivos adjuntos -->
            <div class="torneo-sidebar-card">
                <div class="torneo-sidebar-label"><i class="bi bi-paperclip"></i> Documentos</div>
                <a href="/Torneos/Reglamento/@t.Id" target="_blank" class="archivo-btn">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>Descargar Reglamento</span>
                    <i class="bi bi-download" style="margin-left:auto;font-size:12px;color:var(--color-text-muted);"></i>
                </a>
                @if (!string.IsNullOrEmpty(t.UrlGrupoWhatsApp))
                {
                    <a href="@t.UrlGrupoWhatsApp" target="_blank" rel="noopener" class="archivo-btn whatsapp">
                        <i class="bi bi-whatsapp"></i>
                        <span>Grupo WhatsApp</span>
                        <i class="bi bi-box-arrow-up-right" style="margin-left:auto;font-size:12px;color:var(--color-text-muted);"></i>
                    </a>
                }
            </div>

            <!-- Info del torneo -->
            <div class="torneo-sidebar-card">
                <div class="torneo-sidebar-label"><i class="bi bi-info-circle"></i> Información</div>
                <div class="torneo-info-list">
                    <div class="torneo-info-row">
                        <span class="torneo-info-key">Liga</span>
                        <span class="torneo-info-val">@t.LigaNombre</span>
                    </div>
                    <div class="torneo-info-row">
                        <span class="torneo-info-key">Categoría</span>
                        <span class="torneo-info-val">@t.CategoriaNombre</span>
                    </div>
                    <div class="torneo-info-row">
                        <span class="torneo-info-key">Formato</span>
                        <span class="torneo-info-val">@t.FormatoDisplay</span>
                    </div>
                    <div class="torneo-info-row">
                        <span class="torneo-info-key">Equipos</span>
                        <span class="torneo-info-val">@t.EquiposInscritos @(t.EquiposMaximo.HasValue ? $"/ {t.EquiposMaximo}" : "inscritos")</span>
                    </div>
                    <div class="torneo-info-row">
                        <span class="torneo-info-key">Inicio</span>
                        <span class="torneo-info-val">@t.FechaInicio.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="torneo-info-row" style="border:none;">
                        <span class="torneo-info-key">Fin</span>
                        <span class="torneo-info-val">@t.FechaFin.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Footer mínimo -->
<footer class="footer-landing" style="padding:var(--spacing-xl);">
    <div style="max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
        <a href="/" class="brand-logo-text" style="font-size:var(--text-xl);text-decoration:none;">Blaze<span class="accent-dot">bol</span></a>
        <a asp-page="/Torneos/Index" style="font-size:var(--text-sm);color:var(--color-text-muted);">← Todos los torneos</a>
    </div>
</footer>

@section Scripts {
    <script>
        const nav = document.getElementById('detNavbar');
        window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40));

        // Smooth scroll en sub-nav
        document.querySelectorAll('[data-tab]').forEach(link => {
            link.addEventListener('click', e => {
                const id = link.getAttribute('href');
                const target = document.querySelector(id);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    document.querySelectorAll('[data-tab]').forEach(l => l.classList.remove('active'));
                    link.classList.add('active');
                }
            });
        });
    </script>
}
