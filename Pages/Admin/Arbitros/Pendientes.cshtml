@page
@model ControlTorneosFutbol.Pages.Admin.Arbitros.PendientesModel
@{
    ViewData["Title"] = "Árbitros Pendientes de Aprobación";
}

<div class="page-header">
    <div>
        <h1>Árbitros Pendientes de Aprobación</h1>
        <p class="page-subtitle">Revisa y aprueba nuevos árbitros</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (Model.ArbitrosPendientes.Any())
{
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Número Licencia</th>
                    <th>Categorías</th>
                    <th>Fecha Solicitud</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var arbitro in Model.ArbitrosPendientes)
                {
                    <tr>
                        <td><strong>@arbitro.NombreCompleto</strong></td>
                        <td>@arbitro.Email</td>
                        <td><span class="badge badge-outline">@arbitro.NumeroLicencia</span></td>
                        <td>
                            @foreach (var cat in arbitro.CategoriasArbitra.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge badge-warning" style="margin-right:3px;">@cat.Trim()</span>
                            }
                        </td>
                        <td>@arbitro.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                        <td class="actions-cell">
                            <form method="post" asp-page-handler="Aprobar" asp-route-id="@arbitro.ArbitroId" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-success btn-icon"
                                        onclick="ctConfirmForm(event, this, '¿Aprobar a este árbitro?', {title:'Aprobar árbitro', confirmColor:'#34c759', confirmText:'Sí, aprobar'})">
                                    <i class="bi bi-check-lg"></i> Aprobar
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Rechazar" asp-route-id="@arbitro.ArbitroId" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon"
                                        onclick="ctConfirmForm(event, this, '¿Rechazar a este árbitro?')">
                                    <i class="bi bi-x-lg"></i> Rechazar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-summary">
        <p>@Model.ArbitrosPendientes.Count árbitro(s) pendiente(s) de aprobación</p>
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-person-check empty-icon"></i>
        <p>No hay árbitros pendientes de aprobación</p>
    </div>
}