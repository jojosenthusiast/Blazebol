@page "{id:int}"
@model ControlTorneosFutbol.Pages.Admin.Partidos.EditarModel
@{
    ViewData["Title"] = "Editar Partido";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Admin/Partidos/Details" asp-route-id="@Model.Input.Id" class="back-link">← Volver al Detalle</a>
            <h1>Editar Partido</h1>
            <p class="page-subtitle">@Model.NombreLocal vs @Model.NombreVisitante &nbsp;·&nbsp; @Model.NombreTorneo</p>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-error">
            @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="form-container" style="max-width:520px;">
        <form method="post" class="form-horizontal">
            <input type="hidden" asp-for="Input.Id" />

            <div class="form-section">
                <h3 class="form-section-title">Estado del Partido</h3>

                <div class="form-group">
                    <label asp-for="Input.Estado"></label>
                    <select asp-for="Input.Estado" class="form-control" id="estadoSelect">
                        <option value="Programado">Programado</option>
                        <option value="EnCurso">En Curso</option>
                        <option value="Finalizado">Finalizado</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>
                    <span asp-validation-for="Input.Estado" class="text-danger"></span>
                </div>

                <div id="resultadoSection">
                    <p style="font-size:0.82rem;opacity:0.55;margin-bottom:10px;">
                        Registra el resultado final del partido.
                    </p>
                    <div class="form-row">
                        <div class="form-group">
                            <label>@Model.NombreLocal <span style="opacity:0.5;font-size:0.8rem;">(Local)</span></label>
                            <input asp-for="Input.GolesLocal" class="form-control" type="number"
                                   min="0" max="99" placeholder="Goles" class="input-sm" />
                            <span asp-validation-for="Input.GolesLocal" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>@Model.NombreVisitante <span style="opacity:0.5;font-size:0.8rem;">(Visitante)</span></label>
                            <input asp-for="Input.GolesVisitante" class="form-control" type="number"
                                   min="0" max="99" placeholder="Goles" class="input-sm" />
                            <span asp-validation-for="Input.GolesVisitante" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="form-section-title">Información Logística</h3>

                <div class="form-group">
                    <label asp-for="Input.Fecha"></label>
                    <input asp-for="Input.Fecha" class="form-control" type="datetime-local"
                           value="@Model.Input.Fecha.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="Input.Fecha" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Sede"></label>
                    <input asp-for="Input.Sede" class="form-control" placeholder="Ej: Estadio Nacional, Cancha A" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.ArbitroId"></label>
                    <select asp-for="Input.ArbitroId" class="form-control">
                        <option value="">-- Sin árbitro asignado --</option>
                        @foreach (var a in Model.Arbitros)
                        {
                            <option value="@a.Id">@a.NombreCompleto</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-icon">
                    <i class="bi bi-floppy"></i> Guardar Cambios
                </button>
                <a asp-page="/Admin/Partidos/Details" asp-route-id="@Model.Input.Id" class="btn btn-secondary btn-icon">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const estadoSelect = document.getElementById('estadoSelect');
        const resultadoSection = document.getElementById('resultadoSection');

        function toggleResultado() {
            resultadoSection.style.display = estadoSelect.value === 'Finalizado' ? 'block' : 'none';
        }

        estadoSelect.addEventListener('change', toggleResultado);
        toggleResultado();
    </script>
}
