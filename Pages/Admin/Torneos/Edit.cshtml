@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Editar Torneo";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <a asp-page="/Admin/Torneos/Details" asp-route-id="@Model.Input.Id" class="back-link">← Volver al Detalle</a>
            <h1>Editar Torneo</h1>
            <p class="page-subtitle">@Model.Input.Nombre</p>
        </div>
        @if (!Model.EsFinalizado)
        {
            <span class="badge badge-@Model.Input.Estado.ToLower()">@Model.Input.Estado</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    @if (Model.EsFinalizado)
    {
        <div style="border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:24px;background:rgba(239,68,68,0.06);margin-bottom:24px;">
            <div style="font-weight:700;font-size:1rem;color:#ef4444;margin-bottom:8px;">Torneo Finalizado — Solo Lectura</div>
            <p style="font-size:0.88rem;opacity:0.7;margin:0 0 16px;">
                Este torneo ha sido marcado como <strong>Finalizado</strong> y no permite modificaciones de estructura.
                Solo se puede consultar la información.
            </p>
            <a asp-page="/Admin/Torneos/Details" asp-route-id="@Model.Input.Id" class="btn btn-secondary">
                Ver Detalles del Torneo
            </a>
        </div>

        <!-- Vista de solo lectura del torneo finalizado -->
        <div class="form-container" style="opacity:0.65;pointer-events:none;">
            <div class="form-section">
                <h3 class="form-section-title">Información (Solo Lectura)</h3>
                <div class="form-row">
                    <div class="form-group">
                        <label>Nombre del Torneo</label>
                        <input type="text" class="form-control" value="@Model.Input.Nombre" disabled />
                    </div>
                    <div class="form-group">
                        <label>Estado</label>
                        <input type="text" class="form-control" value="@Model.Input.Estado" disabled />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Fecha Inicio</label>
                        <input type="text" class="form-control" value="@Model.Input.FechaInicio.ToString("dd/MM/yyyy")" disabled />
                    </div>
                    <div class="form-group">
                        <label>Fecha Fin</label>
                        <input type="text" class="form-control" value="@Model.Input.FechaFin.ToString("dd/MM/yyyy")" disabled />
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="form-container">
            <form method="post" class="form-horizontal">
                <input type="hidden" asp-for="Input.Id" />

                <div class="form-section">
                    <h3 class="form-section-title">Información Básica</h3>

                    <div class="form-group">
                        <label asp-for="Input.Nombre" class="required"></label>
                        <input asp-for="Input.Nombre" class="form-control" maxlength="150" />
                        <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.LigaId" class="required"></label>
                            <select asp-for="Input.LigaId" class="form-control"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Ligas, "Id", "Nombre"))">
                                <option value="">— Seleccione una liga —</option>
                            </select>
                            <span asp-validation-for="Input.LigaId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.TemporadaId" class="required"></label>
                            <select asp-for="Input.TemporadaId" class="form-control">
                                <option value="">— Seleccione una temporada —</option>
                                @foreach (var temporada in Model.Temporadas)
                                {
                                    <option value="@temporada.Id">@temporada.Nombre (@temporada.Anio)</option>
                                }
                            </select>
                            <span asp-validation-for="Input.TemporadaId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.CategoriaId" class="required"></label>
                            <select asp-for="Input.CategoriaId" class="form-control"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categorias, "Id", "Nombre"))">
                                <option value="">— Seleccione una categoría —</option>
                            </select>
                            <span asp-validation-for="Input.CategoriaId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Formato" class="required"></label>
                            <select asp-for="Input.Formato" class="form-control">
                                <option value="">— Seleccione un formato —</option>
                                <option value="TodosContraTodos">Todos contra Todos (Liga)</option>
                                <option value="EliminacionDirecta">Eliminación Directa</option>
                                <option value="GruposYEliminacion">Grupos + Eliminación</option>
                            </select>
                            <span asp-validation-for="Input.Formato" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Fechas del Torneo</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.FechaInicio" class="required"></label>
                            <input asp-for="Input.FechaInicio" class="form-control" type="date" />
                            <span asp-validation-for="Input.FechaInicio" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.FechaFin" class="required"></label>
                            <input asp-for="Input.FechaFin" class="form-control" type="date" />
                            <span asp-validation-for="Input.FechaFin" class="text-danger"></span>
                            <small class="form-hint">Debe ser posterior a la fecha de inicio.</small>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Número de Equipos</h3>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.NumeroEquiposMinimo" class="required"></label>
                            <input asp-for="Input.NumeroEquiposMinimo" class="form-control" type="number" min="2" max="100" />
                            <span asp-validation-for="Input.NumeroEquiposMinimo" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.NumeroEquiposMaximo"></label>
                            <input asp-for="Input.NumeroEquiposMaximo" class="form-control" type="number" min="2" max="100" />
                            <span asp-validation-for="Input.NumeroEquiposMaximo" class="text-danger"></span>
                            <small class="form-hint">Opcional. Dejar vacío para sin límite.</small>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">Estado del Torneo</h3>

                    <div class="form-group">
                        <label asp-for="Input.Estado" class="required"></label>
                        <select asp-for="Input.Estado" class="form-control" id="selectEstado">
                            <option value="Borrador">Borrador</option>
                            <option value="Activo">Activo</option>
                            <option value="Finalizado">Finalizado</option>
                        </select>
                        <span asp-validation-for="Input.Estado" class="text-danger"></span>
                        <div id="warningFinalizado" style="display:none;margin-top:8px;padding:10px 14px;
                             background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);
                             border-radius:8px;font-size:0.82rem;color:#ef4444;">
                            ⚠️ Marcar como <strong>Finalizado</strong> bloqueará todas las ediciones futuras del torneo. Esta acción no se puede deshacer desde aquí.
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN: LANDING PAGE PÚBLICA -->
                <div class="form-section">
                    <h3 class="form-section-title">Landing Page Pública</h3>
                    <p class="form-text" style="margin-bottom:var(--spacing-md);color:var(--color-text-muted);">
                        Información visible en la página pública del torneo.
                    </p>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.LogoUrl"></label>
                            <input asp-for="Input.LogoUrl" class="form-control" placeholder="https://..." />
                            <small class="form-text">URL del logo (PNG transparente, 200×200px)</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.ImagenUrl"></label>
                            <input asp-for="Input.ImagenUrl" class="form-control" placeholder="https://..." />
                            <small class="form-text">URL de imagen principal/banner (1200×600px)</small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.DescripcionCompleta"></label>
                        <textarea asp-for="Input.DescripcionCompleta" class="form-control" rows="5"
                                  placeholder="Descripción detallada del torneo..."></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.Ubicacion"></label>
                            <input asp-for="Input.Ubicacion" class="form-control" placeholder="Ej: San Salvador, El Salvador" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.DireccionSede"></label>
                            <input asp-for="Input.DireccionSede" class="form-control" placeholder="Dirección completa de la sede" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.UrlGrupoWhatsApp"></label>
                            <input asp-for="Input.UrlGrupoWhatsApp" class="form-control" placeholder="https://chat.whatsapp.com/..." />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Input.Frase1"></label>
                            <input asp-for="Input.Frase1" class="form-control" maxlength="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Frase2"></label>
                            <input asp-for="Input.Frase2" class="form-control" maxlength="100" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Frase3"></label>
                            <input asp-for="Input.Frase3" class="form-control" maxlength="100" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Galería de Fotos (URLs)</label>
                        <div id="galeria-list"></div>
                        <button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="agregarImagen()">
                            <i class="bi bi-plus-lg"></i> Agregar foto
                        </button>
                        <input type="hidden" asp-for="Input.ImagenesGaleria" id="galeriaInput" />
                    </div>

                    <div class="form-group">
                        <label>Logos de Patrocinadores (URLs)</label>
                        <div id="patrocinadores-list"></div>
                        <button type="button" class="btn btn-secondary btn-sm btn-icon" onclick="agregarPatrocinador()">
                            <i class="bi bi-plus-lg"></i> Agregar patrocinador
                        </button>
                        <input type="hidden" asp-for="Input.Patrocinadores" id="patrocinadoresInput" />
                    </div>
                </div>

                <!-- SECCIÓN: CONFIGURACIÓN DE FIXTURE -->
                <div class="form-section" id="seccionFixture">
                    <h3 class="form-section-title">Configuración de Fixture Automático</h3>
                    <p style="margin-bottom:var(--spacing-md);color:var(--color-text-muted);font-size:0.88rem;">
                        Estas opciones se usan al generar el calendario de partidos automáticamente.
                    </p>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input asp-for="Input.IdaYVuelta" type="checkbox" />
                                <span>Ida y Vuelta</span>
                            </label>
                            <small class="form-text">Genera partidos de ida y de vuelta con roles invertidos.</small>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input asp-for="Input.CampoNeutral" type="checkbox" />
                                <span>Campo Neutral</span>
                            </label>
                            <small class="form-text">Todos los partidos se juegan en sede neutral.</small>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input asp-for="Input.EquilibrioLocalVisitante" type="checkbox" />
                                <span>Equilibrar Local/Visitante</span>
                            </label>
                            <small class="form-text">Alterna roles en jornadas pares para reducir ventaja local.</small>
                        </div>
                    </div>

                    <div class="form-row" id="camposGrupos" style="display:none">
                        <div class="form-group">
                            <label asp-for="Input.NumeroGrupos"></label>
                            <input asp-for="Input.NumeroGrupos" class="form-control" type="number" min="2" max="16" placeholder="Ej: 4" />
                            <small class="form-text">Cantidad de grupos (A, B, C…).</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.EquiposPorGrupo"></label>
                            <input asp-for="Input.EquiposPorGrupo" class="form-control" type="number" min="2" max="20" placeholder="Ej: 4" />
                            <small class="form-text">Equipos que conforman cada grupo.</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.ClasificanPorGrupo"></label>
                            <input asp-for="Input.ClasificanPorGrupo" class="form-control" type="number" min="1" max="10" placeholder="2" />
                            <small class="form-text">Equipos de cada grupo que avanzan a la fase eliminatoria.</small>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-icon">
                        <i class="bi bi-floppy"></i> Guardar Cambios
                    </button>
                    <a asp-page="/Admin/Torneos/Details" asp-route-id="@Model.Input.Id" class="btn btn-secondary btn-icon">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('selectEstado')?.addEventListener('change', function () {
            document.getElementById('warningFinalizado').style.display =
                this.value === 'Finalizado' ? 'block' : 'none';
        });

        // === Fixture: mostrar campos de grupos solo para GruposYEliminacion ===
        const formatoSelect = document.querySelector('select[name="Input.Formato"]');
        const camposGrupos = document.getElementById('camposGrupos');
        function toggleGrupos() {
            if (camposGrupos) camposGrupos.style.display = formatoSelect?.value === 'GruposYEliminacion' ? '' : 'none';
        }
        formatoSelect?.addEventListener('change', toggleGrupos);
        toggleGrupos();

        // === Galería ===
        let galeriaUrls = @Html.Raw(string.IsNullOrEmpty(Model.Input.ImagenesGaleria) ? "[]" : Model.Input.ImagenesGaleria);

        function agregarImagen() {
            const url = prompt('URL de la imagen:');
            if (url && url.trim()) { galeriaUrls.push(url.trim()); renderGaleria(); }
        }

        function eliminarImagen(i) { galeriaUrls.splice(i, 1); renderGaleria(); }

        function renderGaleria() {
            const c = document.getElementById('galeria-list');
            c.innerHTML = galeriaUrls.map((url, i) => `
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;background:var(--color-bg-hover);padding:8px;border-radius:8px;">
                    <img src="${url}" style="width:40px;height:40px;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'" />
                    <span style="flex:1;font-size:0.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${url}</span>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarImagen(${i})"><i class="bi bi-trash"></i></button>
                </div>`).join('');
            document.getElementById('galeriaInput').value = JSON.stringify(galeriaUrls);
        }

        // === Patrocinadores ===
        let patrocinadoresUrls = @Html.Raw(string.IsNullOrEmpty(Model.Input.Patrocinadores) ? "[]" : Model.Input.Patrocinadores);

        function agregarPatrocinador() {
            const url = prompt('URL del logo del patrocinador:');
            if (url && url.trim()) { patrocinadoresUrls.push(url.trim()); renderPatrocinadores(); }
        }

        function eliminarPatrocinador(i) { patrocinadoresUrls.splice(i, 1); renderPatrocinadores(); }

        function renderPatrocinadores() {
            const c = document.getElementById('patrocinadores-list');
            c.innerHTML = patrocinadoresUrls.map((url, i) => `
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;background:var(--color-bg-hover);padding:8px;border-radius:8px;">
                    <img src="${url}" style="width:40px;height:30px;object-fit:contain;border-radius:4px;background:#fff;" onerror="this.style.display='none'" />
                    <span style="flex:1;font-size:0.85rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${url}</span>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarPatrocinador(${i})"><i class="bi bi-trash"></i></button>
                </div>`).join('');
            document.getElementById('patrocinadoresInput').value = JSON.stringify(patrocinadoresUrls);
        }

        // Render initial values from existing data
        renderGaleria();
        renderPatrocinadores();
    </script>
}
