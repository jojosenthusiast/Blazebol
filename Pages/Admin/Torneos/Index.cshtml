@page
@model IndexModel
@{
    ViewData["Title"] = "Gestión de Torneos";
    Layout = "_Layout";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <h1>Gestión de Torneos</h1>
            <p class="page-subtitle">Administra todos los torneos</p>
        </div>

        <div class="header-actions">
        <form method="post" asp-page-handler="ExportarPDF" style="display: inline; margin-right: 8px;">
            <button type="submit" class="btn btn-secondary">Exportar PDF</button>
        </form>
        <a asp-page="/Admin/Torneos/Create" class="btn btn-primary">Crear Torneo</a>
    </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <div class="filters-section">
        <form method="get" class="filters-form">
            <div class="filter-group">
                <label>Estado:</label>
                <select name="estado" class="form-control" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    <option value="Borrador" selected="@(Model.FiltroEstado == "Borrador")">Borrador</option>
                    <option value="Activo" selected="@(Model.FiltroEstado == "Activo")">Activo</option>
                    <option value="Finalizado" selected="@(Model.FiltroEstado == "Finalizado")">Finalizado</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Año:</label>
                <select name="anio" class="form-control" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    @foreach (var anio in Model.AniosDisponibles)
                    {
                        <option value="@anio" selected="@(Model.FiltroAnio == anio)">@anio</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>Categoría:</label>
                <select name="categoriaId" class="form-control" onchange="this.form.submit()">
                    <option value="">Todas</option>
                    @foreach (var cat in Model.CategoriasDisponibles)
                    {
                        <option value="@cat.Key" selected="@(Model.FiltroCategoriaId == cat.Key)">@cat.Value</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-secondary">Filtrar</button>
            <a asp-page="/Admin/Torneos/Index" class="btn btn-link">Limpiar Filtros</a>
        </form>
    </div>

    @if (Model.Torneos.Any())
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Liga</th>
                        <th>Temporada</th>
                        <th>Categoría</th>
                        <th>Formato</th>
                        <th>Estado</th>
                        <th>Equipos</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var torneo in Model.Torneos)
                    {
                        <tr>
                            <td><strong>@torneo.Nombre</strong></td>
                            <td>@torneo.NombreLiga</td>
                            <td>@torneo.NombreTemporada</td>
                            <td>@torneo.NombreCategoria</td>
                            <td>
                                @switch (torneo.Formato)
                                {
                                    case "TodosContraTodos":
                                        <span>Todos contra Todos</span>
                                        break;
                                    case "EliminacionDirecta":
                                        <span>Eliminación Directa</span>
                                        break;
                                    case "GruposYEliminacion":
                                        <span>Grupos + Eliminación</span>
                                        break;
                                    default:
                                        <span>@torneo.Formato</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="badge badge-@torneo.Estado.ToLower()">
                                    @torneo.Estado
                                </span>
                            </td>
                            <td>
                                @torneo.NumeroEquiposInscritos @(torneo.NumeroEquiposMaximo.HasValue ? $"/ {torneo.NumeroEquiposMaximo}" : "")
                            </td>
                            <td>@torneo.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@torneo.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="actions-cell" style="white-space:nowrap;">
                                <a asp-page="/Admin/Torneos/Details" asp-route-id="@torneo.Id"
                                   class="btn btn-sm btn-secondary" style="margin-right:4px;">Ver</a>
                                @if (torneo.PuedeEditar)
                                {
                                    <a asp-page="/Admin/Torneos/Edit" asp-route-id="@torneo.Id"
                                       class="btn btn-sm btn-primary" style="margin-right:4px;">Editar</a>
                                }
                                @if (torneo.Estado != "Finalizado")
                                {
                                    <form method="post" asp-page-handler="Desactivar" asp-route-id="@torneo.Id"
                                          style="display:inline;"
                                          onsubmit="return confirm('¿Finalizar este torneo? Esta acción no se puede deshacer.');">
                                        <button type="submit" class="btn btn-sm"
                                                style="background:rgba(239,68,68,0.15);color:#ef4444;border:1px solid rgba(239,68,68,0.3);">
                                            Finalizar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-summary">
            <p>Mostrando @Model.Torneos.Count torneo(s)</p>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No se encontraron torneos con los filtros seleccionados</p>
            <a asp-page="/Admin/Torneos/Create" class="btn btn-primary">Crear Primer Torneo</a>
        </div>
    }
</div>