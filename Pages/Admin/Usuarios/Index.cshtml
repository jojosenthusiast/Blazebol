@page
@model ControlTorneosFutbol.Pages.Admin.Usuarios.IndexModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="page-header">
    <div>
        <h1>Gestión de Usuarios</h1>
        <p class="page-subtitle">Administra todos los usuarios del sistema</p>
    </div>
    <div class="header-actions">
        <form method="post" asp-page-handler="ExportarPDF" style="display: inline;">
            <button type="submit" class="btn btn-info btn-icon">
                <i class="bi bi-file-earmark-pdf"></i> Exportar PDF
            </button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="filters-section">
    <form method="get" class="filters-form">
        <div class="filter-group">
            <label>Rol:</label>
            <select name="rol" class="form-control" onchange="this.form.submit()">
                <option value="">Todos</option>
                <option value="Administrador" selected="@(Model.FiltroRol == "Administrador")">Administrador</option>
                <option value="Jugador" selected="@(Model.FiltroRol == "Jugador")">Jugador</option>
                <option value="Entrenador" selected="@(Model.FiltroRol == "Entrenador")">Entrenador</option>
                <option value="Arbitro" selected="@(Model.FiltroRol == "Arbitro")">Árbitro</option>
                <option value="Espectador" selected="@(Model.FiltroRol == "Espectador")">Espectador</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Estado:</label>
            <select name="activo" class="form-control" onchange="this.form.submit()">
                <option value="">Todos</option>
                <option value="true" selected="@(Model.FiltroActivo == true)">Activos</option>
                <option value="false" selected="@(Model.FiltroActivo == false)">Inactivos</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-secondary btn-sm btn-icon">
                <i class="bi bi-search"></i> Filtrar
            </button>
            <a asp-page="/Admin/Usuarios/Index" class="btn btn-link btn-sm btn-icon">
                <i class="bi bi-x-circle"></i> Limpiar
            </a>
        </div>
    </form>
</div>

@if (Model.Usuarios.Any())
{
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Seguridad</th>
                    <th>Fecha Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td><strong>@usuario.NombreCompleto</strong></td>
                        <td>@usuario.Email</td>
                        <td>
                            <span class="badge badge-@usuario.Rol.ToLower()">@usuario.Rol</span>
                        </td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="badge badge-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (usuario.EstaBloqueado)
                            {
                                <div class="security-status">
                                    <span class="badge badge-danger">
                                        <i class="bi bi-lock-fill"></i> Bloqueado
                                    </span>
                                    <small class="text-muted">hasta @usuario.FechaBloqueoFin?.ToString("dd/MM HH:mm")</small>
                                    <small class="text-error">@usuario.ContadorAccesosFallidos intento(s) fallido(s)</small>
                                </div>
                            }
                            else if (usuario.ContadorAccesosFallidos > 0)
                            {
                                <div class="security-status">
                                    <span class="badge badge-warning">
                                        <i class="bi bi-exclamation-triangle"></i> @usuario.ContadorAccesosFallidos intento(s)
                                    </span>
                                    <small class="text-muted">@(5 - usuario.ContadorAccesosFallidos) restante(s)</small>
                                </div>
                            }
                            else
                            {
                                <span class="badge badge-success">
                                    <i class="bi bi-check-circle"></i> OK
                                </span>
                            }
                        </td>
                        <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="actions-cell">
                            <a asp-page="/Admin/Usuarios/Details" asp-route-id="@usuario.UsuarioId"
                               class="btn btn-sm btn-info btn-icon">
                                <i class="bi bi-eye"></i> Ver
                            </a>

                            @if (usuario.EstaBloqueado)
                            {
                                <form method="post" asp-page-handler="Desbloquear" asp-route-id="@usuario.UsuarioId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-info btn-icon"
                                            onclick="ctConfirmForm(event, this, '¿Desbloquear este usuario?', {title:'Desbloquear', confirmColor:'#5ac8fa', confirmText:'Sí, desbloquear'})">
                                        <i class="bi bi-unlock"></i> Desbloquear
                                    </button>
                                </form>
                            }

                            @if (usuario.Activo)
                            {
                                <form method="post" asp-page-handler="Desactivar" asp-route-id="@usuario.UsuarioId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger btn-icon"
                                            onclick="ctConfirmForm(event, this, '¿Desactivar este usuario?')">
                                        <i class="bi bi-person-x"></i> Desactivar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activar" asp-route-id="@usuario.UsuarioId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-success btn-icon"
                                            onclick="ctConfirmForm(event, this, '¿Reactivar este usuario?', {title:'Activar usuario', confirmColor:'#34c759', confirmText:'Sí, activar'})">
                                        <i class="bi bi-person-check"></i> Activar
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-summary">
        <p>Mostrando @Model.Usuarios.Count usuario(s)</p>
    </div>
}
else
{
    <div class="empty-state">
        <p>No se encontraron usuarios con los filtros seleccionados</p>
    </div>
}