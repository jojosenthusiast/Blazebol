@page "{id:guid}"
@model ControlTorneosFutbol.Pages.Admin.Usuarios.DetailsModel
@{
    ViewData["Title"] = "Detalles de Usuario";
}

<div class="page-header">
    <div>
        <h1>Detalles de Usuario</h1>
        <p class="page-subtitle">Información completa del usuario</p>
    </div>
    <div class="header-actions">
        <a asp-page="/Admin/Usuarios/Index" class="btn btn-secondary">← Volver al Listado</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

@if (Model.Usuario == null)
{
    <div class="alert alert-error">
        Usuario no encontrado
    </div>
}
else
{
    <div class="details-grid">
        <div class="detail-card">
            <h3>Información de Cuenta</h3>
            <div class="detail-row">
                <span class="detail-label">Email:</span>
                <span class="detail-value">@Model.Usuario.Email</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Rol:</span>
                <span class="detail-value">
                    <span class="badge badge-@Model.Usuario.Rol.ToLower()">@Model.Usuario.Rol</span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Estado:</span>
                <span class="detail-value">
                    @if (Model.Usuario.Activo)
                    {
                        <span class="badge badge-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-inactive">Inactivo</span>
                    }
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Fecha Registro:</span>
                <span class="detail-value">@Model.Usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <div class="detail-card">
            <h3>Información Personal</h3>
            <div class="detail-row">
                <span class="detail-label">Nombre Completo:</span>
                <span class="detail-value">@Model.Usuario.NombreCompleto</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Usuario.Telefono))
            {
                <div class="detail-row">
                    <span class="detail-label">Teléfono:</span>
                    <span class="detail-value">@Model.Usuario.Telefono</span>
                </div>
            }
        </div>

        @if (Model.Usuario.Rol == "Jugador" && Model.Usuario.JugadorInfo != null)
        {
            <div class="detail-card">
                <h3>Información de Jugador</h3>
                <div class="detail-row">
                    <span class="detail-label">Posición Preferida:</span>
                    <span class="detail-value">@(Model.Usuario.JugadorInfo.PosicionPreferida ?? "No especificada")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Número de Camiseta:</span>
                    <span class="detail-value">@(Model.Usuario.JugadorInfo.NumeroCamiseta?.ToString() ?? "No asignado")</span>
                </div>
            </div>
        }

        @if (Model.Usuario.Rol == "Entrenador" && Model.Usuario.EntrenadorInfo != null)
        {
            <div class="detail-card">
                <h3>Información de Entrenador</h3>
                <div class="detail-row">
                    <span class="detail-label">Número de Licencia:</span>
                    <span class="detail-value">@(Model.Usuario.EntrenadorInfo.NumeroLicencia ?? "No especificado")</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Usuario.EntrenadorInfo.EquipoNombre))
                {
                    <div class="detail-row">
                        <span class="detail-label">Equipo:</span>
                        <span class="detail-value">@Model.Usuario.EntrenadorInfo.EquipoNombre</span>
                    </div>
                }
            </div>
        }

        @if (Model.Usuario.Rol == "Arbitro" && Model.Usuario.ArbitroInfo != null)
        {
            <div class="detail-card">
                <h3>Información de Árbitro</h3>
                <div class="detail-row">
                    <span class="detail-label">Número de Licencia:</span>
                    <span class="detail-value">@Model.Usuario.ArbitroInfo.NumeroLicencia</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Categorías:</span>
                    <span class="detail-value">@Model.Usuario.ArbitroInfo.CategoriasArbitra</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Estado Aprobación:</span>
                    <span class="detail-value">
                        @if (Model.Usuario.ArbitroInfo.EstadoAprobacion == "Aprobado")
                        {
                            <span class="badge badge-success">Aprobado</span>
                        }
                        else if (Model.Usuario.ArbitroInfo.EstadoAprobacion == "Pendiente")
                        {
                            <span class="badge badge-warning">Pendiente</span>
                        }
                        else
                        {
                            <span class="badge badge-error">Rechazado</span>
                        }
                    </span>
                </div>
                @if (Model.Usuario.ArbitroInfo.FechaAprobacion.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Fecha Aprobación:</span>
                        <span class="detail-value">@Model.Usuario.ArbitroInfo.FechaAprobacion.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        }

        <div class="detail-card">
            <h3>🔐 Seguridad</h3>
            
            @if (Model.Usuario.FechaBloqueoFin.HasValue && Model.Usuario.FechaBloqueoFin.Value > DateTime.UtcNow)
            {
                <div style="background-color: rgba(255, 59, 48, 0.1); padding: 16px; border-radius: 8px; margin-bottom: 16px; border: 1px solid var(--color-error);">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                        <span style="font-size: 24px;">🔒</span>
                        <strong style="color: var(--color-error); font-size: 16px;">CUENTA BLOQUEADA</strong>
                    </div>
                    <div class="detail-row" style="border: none; padding: 4px 0;">
                        <span class="detail-label">Bloqueado hasta:</span>
                        <span class="detail-value" style="color: var(--color-error); font-weight: 600;">
                            @Model.Usuario.FechaBloqueoFin.Value.ToString("dd/MM/yyyy HH:mm:ss")
                        </span>
                    </div>
                    <div class="detail-row" style="border: none; padding: 4px 0;">
                        <span class="detail-label">Tiempo restante:</span>
                        <span class="detail-value" style="color: var(--color-error); font-weight: 600;">
                            @{
                                var minutosRestantes = Math.Ceiling((Model.Usuario.FechaBloqueoFin.Value - DateTime.UtcNow).TotalMinutes);
                            }
                            ~@minutosRestantes minuto(s)
                        </span>
                    </div>
                    
                    <form method="post" asp-page-handler="Desbloquear" asp-route-id="@Model.Usuario.UsuarioId" style="margin-top: 16px;">
                        <button type="submit" class="btn btn-success" style="width: 100%;">
                            🔓 Desbloquear Cuenta Manualmente
                        </button>
                    </form>
                </div>
            }
            
            <div class="detail-row">
                <span class="detail-label">Intentos Fallidos:</span>
                <span class="detail-value" style="color: @(Model.Usuario.ContadorAccesosFallidos >= 3 ? "var(--color-error)" : "var(--color-text-primary)"); font-weight: @(Model.Usuario.ContadorAccesosFallidos >= 3 ? "600" : "normal");">
                    @Model.Usuario.ContadorAccesosFallidos / 5
                    @if (Model.Usuario.ContadorAccesosFallidos >= 3 && Model.Usuario.ContadorAccesosFallidos < 5)
                    {
                        <span style="color: var(--color-error); font-size: 12px; margin-left: 8px;">
                            (⚠️ Advertencia)
                        </span>
                    }
                </span>
            </div>
            
            @if (Model.Usuario.ContadorAccesosFallidos > 0 && !(Model.Usuario.FechaBloqueoFin.HasValue && Model.Usuario.FechaBloqueoFin.Value > DateTime.UtcNow))
            {
                <div class="detail-row">
                    <span class="detail-label">Intentos Restantes:</span>
                    <span class="detail-value" style="color: var(--color-error); font-weight: 600;">
                        @(5 - Model.Usuario.ContadorAccesosFallidos)
                    </span>
                </div>
            }
            
            @if (Model.Usuario.ContadorAccesosFallidos == 0 && !(Model.Usuario.FechaBloqueoFin.HasValue && Model.Usuario.FechaBloqueoFin.Value > DateTime.UtcNow))
            {
                <div style="background-color: rgba(52, 199, 89, 0.1); padding: 12px; border-radius: 6px; margin-top: 12px; border: 1px solid var(--color-success);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span>✓</span>
                        <span style="color: var(--color-success); font-weight: 500;">Sin problemas de seguridad</span>
                    </div>
                </div>
            }
        </div>
    </div>
}